<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📄 UTSK — Анализ накладных клиента</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg-main: #f1f5f9;
            --bg-card: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --primary: #4f46e5;
            --primary-light: #e0e7ff;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --radius-lg: 16px;
            --radius-md: 12px;
            --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.05);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0f2fe 100%);
            color: var(--text-main);
            min-height: 100vh;
            padding: 24px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .container {
            width: 100%;
            max-width: 1300px;
            margin: 0 auto;
        }

        /* Top Header */
        .top-header {
            background: var(--bg-card);
            padding: 20px 24px;
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #f1f5f9;
            color: var(--text-main);
            text-decoration: none;
            padding: 10px 18px;
            border-radius: var(--radius-md);
            font-weight: 600;
            font-size: 14px;
            border: 1px solid var(--border);
            transition: all 0.2s ease;
        }

        .btn-back:hover {
            background: var(--primary-light);
            color: var(--primary);
            border-color: #c7d2fe;
            transform: translateX(-2px);
        }

        .client-title h1 {
            font-size: 20px;
            font-weight: 800;
            color: var(--text-main);
        }

        .client-meta {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 2px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        select.year-select {
            padding: 9px 16px;
            border-radius: var(--radius-md);
            border: 1px solid var(--border);
            background: #fff;
            font-weight: 700;
            font-size: 14px;
            color: var(--primary);
            cursor: pointer;
        }

        /* KPI Cards Grid */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 24px;
        }

        .kpi-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            padding: 20px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            border-top: 4px solid var(--primary);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .kpi-title {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .kpi-value {
            font-size: 26px;
            font-weight: 800;
            color: var(--text-main);
            margin: 8px 0 4px;
        }

        .kpi-subtext {
            font-size: 12px;
            color: var(--text-muted);
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 24px;
            margin-bottom: 24px;
        }

        @media (max-width: 1024px) {
            .grid-2 { grid-template-columns: 1fr; }
        }

        .panel-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            padding: 24px;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .panel-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-main);
        }

        .chart-container {
            position: relative;
            height: 320px;
            width: 100%;
        }

        /* Tables */
        .table-responsive {
            width: 100%;
            overflow-x: auto;
            border-radius: var(--radius-md);
            border: 1px solid var(--border);
        }

        table.custom-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        table.custom-table th {
            background: #f8fafc;
            color: var(--text-muted);
            font-weight: 700;
            padding: 12px 16px;
            border-bottom: 2px solid var(--border);
            text-align: left;
        }

        table.custom-table td {
            padding: 12px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-main);
        }

        table.custom-table tbody tr.clickable-row {
            cursor: pointer;
            transition: background 0.15s;
        }

        table.custom-table tbody tr.clickable-row:hover {
            background: #eef2ff;
        }

        .month-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            background: #e0e7ff;
            color: #4f46e5;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.15s;
        }

        .month-btn:hover {
            background: #4f46e5;
            color: white;
        }

        /* Badges */
        .badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }
        .badge-positive { background: #d1fae5; color: #047857; }
        .badge-negative { background: #fee2e2; color: #b91c1c; }
        .badge-neutral { background: #f1f5f9; color: #475569; }
        .badge-status { background: #e0f2fe; color: #0369a1; }
    </style>
</head>
<body>
    <div class="container">
        <!-- Top Header -->
        <header class="top-header">
            <div class="header-left">
                <a href="#" id="btn-client-detail" class="btn-back">← В карточку клиента</a>
                <div class="client-title">
                    <h1 id="client-name">📄 Анализ накладных клиента</h1>
                    <div class="client-meta">
                        <span>Код: <strong id="client-code">—</strong></span>
                        <span>•</span>
                        <span class="badge badge-status" id="client-status">—</span>
                    </div>
                </div>
            </div>
            <div>
                <label style="font-size:13px;font-weight:600;color:var(--text-muted);">Год:</label>
                <select id="year-select" class="year-select" onchange="loadData()">
                    <option value="2026" selected>2026</option>
                    <option value="2025">2025</option>
                    <option value="2024">2024</option>
                </select>
            </div>
        </header>

        <!-- KPI Cards Grid -->
        <section class="kpi-grid">
            <div class="kpi-card" style="border-top-color: #4f46e5;">
                <span class="kpi-title" id="kpi-curr-lbl">📄 Всего накладных 2026</span>
                <span class="kpi-value" id="kpi-inv-curr" style="color:#4f46e5;">—</span>
                <div class="kpi-subtext" style="display:flex; flex-direction:column; gap:3px; margin-top:4px;">
                    <span id="kpi-pos-curr-sub" style="font-weight:600; color:#475569;">📦 Позицій: —</span>
                    <span id="kpi-unique-positions" style="font-weight:700; color:#7c3aed;">🔑 Унікальних: —</span>
                </div>
            </div>
            <div class="kpi-card" style="border-top-color: #64748b;">
                <span class="kpi-title" id="kpi-prev-lbl">📅 Накладных за 2025 год</span>
                <span class="kpi-value" id="kpi-inv-prev">—</span>
                <div class="kpi-subtext" style="display:flex; flex-direction:column; gap:3px; margin-top:4px;">
                    <span id="kpi-pos-prev-sub" style="font-weight:500; color:#64748b;">Сравнение YoY</span>
                </div>
            </div>
            <div class="kpi-card" style="border-top-color: #10b981;">
                <span class="kpi-title">📈 Рост заказов YoY</span>
                <span class="kpi-value" id="kpi-growth">—</span>
                <span class="kpi-subtext">Динамика в %</span>
            </div>
            <div class="kpi-card" style="border-top-color: #06b6d4;">
                <span class="kpi-title">📊 Среднемесячно накладных</span>
                <span class="kpi-value" id="kpi-avg-monthly">—</span>
                <span class="kpi-subtext">Заказов в месяц</span>
            </div>
        </section>

        <!-- Main Grid -->
        <div class="grid-2">
            <div class="panel-card">
                <div class="panel-title">📊 График количества накладных по месяцам</div>
                <div class="chart-container">
                    <canvas id="chart-invoices-bar"></canvas>
                </div>
            </div>

            <div class="panel-card">
                <div class="panel-title">🧩 Сезонность и паттерны отгрузок</div>
                <div style="display:flex;flex-direction:column;gap:14px;">
                    <div style="background:#f8fafc;padding:16px;border-radius:12px;border:1px solid var(--border);">
                        <div style="font-size:12px;color:var(--text-muted);font-weight:700;text-transform:uppercase;">🔥 Пиковый месяц</div>
                        <div style="font-size:22px;font-weight:800;color:#4f46e5;margin-top:4px;" id="pat-peak-month">—</div>
                        <div style="font-size:12px;color:var(--text-muted);margin-top:2px;" id="pat-peak-count">0 накладных</div>
                    </div>
                    <div style="background:#f8fafc;padding:16px;border-radius:12px;border:1px solid var(--border);">
                        <div style="font-size:12px;color:var(--text-muted);font-weight:700;text-transform:uppercase;">📅 Активных месяцев</div>
                        <div style="font-size:22px;font-weight:800;color:#10b981;margin-top:4px;" id="pat-active-months">—</div>
                        <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">из 12 месяцев года</div>
                    </div>
                    <div style="background:#e0e7ff;padding:16px;border-radius:12px;border:1px solid #c7d2fe;">
                        <div style="font-size:12px;color:#3730a3;font-weight:700;text-transform:uppercase;">💡 Аналитическая заметка</div>
                        <div style="font-size:13px;color:#312e81;margin-top:4px;line-height:1.4;" id="pat-note">Анализируем стабильность отгрузок...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table Panel -->
        <div class="panel-card">
            <div class="panel-title">📋 Помесячный отчёт накладных с кликабельным детализированным просмотром</div>
            <div class="table-responsive">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Месяц</th>
                            <th style="text-align:center;">Накладных <span id="th-year-curr">2026</span></th>
                            <th style="text-align:center;">Позицій</th>
                            <th style="text-align:center;">Накладных <span id="th-year-prev">2025</span></th>
                            <th style="text-align:center;">Рост YoY %</th>
                            <th style="text-align:right;">Действие</th>
                        </tr>
                    </thead>
                    <tbody id="invoices-table-body">
                        <tr><td colspan="6" style="text-align:center;">⏳ Загрузка...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const TOKEN = urlParams.get('token') || 'utsk2026';
        const CLIENT_CODE = urlParams.get('code') || '';
        let chartInstance = null;

        function fmtNum(n) { return (n == null) ? '—' : Number(n).toLocaleString('ru-RU'); }
        function fmtPct(n) { return (n == null) ? '—' : n.toFixed(1) + '%'; }

        document.addEventListener('DOMContentLoaded', () => {
            const btnBack = document.getElementById('btn-client-detail');
            if (btnBack) btnBack.href = `/client-detail?token=${TOKEN}&code=${CLIENT_CODE}`;
            loadData();
        });

        async function loadData() {
            const year = document.getElementById('year-select').value;
            try {
                const res = await fetch(`/api/analytics/client/invoices?token=${TOKEN}&code=${CLIENT_CODE}&year=${year}`);
                const data = await res.json();
                if (data.status !== 'ok') return;

                const info = data.client_info;
                document.getElementById('client-name').textContent = `📄 Анализ накладных: ${info.name}`;
                document.getElementById('client-code').textContent = info.code;
                document.getElementById('client-status').textContent = info.status_name;

                const yrNum = parseInt(year, 10) || 2026;
                const thCurr = document.getElementById('th-year-curr');
                if (thCurr) thCurr.textContent = yrNum;
                const thPrev = document.getElementById('th-year-prev');
                if (thPrev) thPrev.textContent = yrNum - 1;

                const kpi = data.kpi;
                const kpiCurrLbl = document.getElementById('kpi-curr-lbl');
                if (kpiCurrLbl) kpiCurrLbl.textContent = `📄 Всего накладных ${yrNum}`;
                const kpiPrevLbl = document.getElementById('kpi-prev-lbl');
                if (kpiPrevLbl) kpiPrevLbl.textContent = `📅 Накладных за ${yrNum - 1} год`;
                
                const posVal = kpi.positions_curr !== undefined ? kpi.positions_curr : (data.total_positions || 0);
                const kpiPosSub = document.getElementById('kpi-pos-curr-sub');
                if (kpiPosSub) {
                    kpiPosSub.textContent = `📦 Позицій: ${fmtNum(posVal)}`;
                }

                const uniqVal = data.unique_positions !== undefined ? data.unique_positions : (kpi.unique_positions || 0);
                const uniqEl = document.getElementById('kpi-unique-positions');
                if (uniqEl) {
                    uniqEl.textContent = `🔑 Унікальних: ${fmtNum(uniqVal)}`;
                }

                const kpiPosPrevSub = document.getElementById('kpi-pos-prev-sub');
                if (kpiPosPrevSub && kpi.positions_prev !== undefined) {
                    kpiPosPrevSub.textContent = `📦 Позицій: ${fmtNum(kpi.positions_prev)} • 🔑 Унік.: ${fmtNum(kpi.unique_positions_prev || 0)}`;
                }

                document.getElementById('kpi-inv-curr').textContent = kpi.invoices_curr;
                document.getElementById('kpi-inv-prev').textContent = kpi.invoices_prev;

                const growthElem = document.getElementById('kpi-growth');
                if (kpi.growth_yoy_pct !== null && kpi.growth_yoy_pct !== undefined) {
                    growthElem.textContent = fmtPct(kpi.growth_yoy_pct);
                    const isGood = kpi.invoices_prev_period !== undefined && kpi.invoices_prev_period !== null
                        ? (kpi.invoices_curr >= kpi.invoices_prev_period)
                        : (kpi.invoices_curr >= kpi.invoices_prev);
                    growthElem.style.color = isGood ? '#10b981' : '#ef4444';
                } else {
                    growthElem.textContent = '—';
                    growthElem.style.color = '#64748b';
                }

                document.getElementById('kpi-avg-monthly').textContent = kpi.avg_monthly_invoices;

                const pat = data.patterns;
                document.getElementById('pat-peak-month').textContent = pat.peak_month_name;
                document.getElementById('pat-peak-count').textContent = `${pat.peak_inv_count} накладных в пиковый месяц`;
                document.getElementById('pat-active-months').textContent = `${pat.active_months_count} / 12`;
                
                document.getElementById('pat-note').textContent = pat.active_months_count >= 6 
                    ? `Клиент регулярно совершает отгрузки (${pat.active_months_count} активных месяцев). Отличная ритмичность.`
                    : `Отгрузки носят эпизодический характер (${pat.active_months_count} активных месяцев). Требуется работа менеджера.`;

                // Monthly Table
                const tbody = document.getElementById('invoices-table-body');
                tbody.innerHTML = '';
                const monthly = data.monthly || [];

                const monthLabels = [];
                const currCounts = [];
                const prevCounts = [];

                monthly.forEach(m => {
                    monthLabels.push(m.month_name);
                    currCounts.push(m.inv_curr);
                    prevCounts.push(m.inv_prev);

                    const posCurr = m.pos_curr ?? m.positions_2026 ?? 0;
                    const uniqCurr = m.unique_positions ?? m.uniq_curr ?? 0;
                    const growthStr = m.growth_pct !== null ? fmtPct(m.growth_pct) : '—';
                    const growthClass = m.growth_pct !== null ? (m.growth_pct >= 100 ? 'badge-positive' : 'badge-negative') : 'badge-neutral';

                    const monthUrl = `/client-invoices-month?token=${TOKEN}&code=${CLIENT_CODE}&year=${year}&month=${m.month}`;

                    const tr = document.createElement('tr');
                    tr.className = 'clickable-row';
                    tr.title = `Открыть накладные за ${m.month_name} ${year}`;
                    tr.onclick = () => { window.location.href = monthUrl; };

                    tr.innerHTML = `
                        <td style="font-weight:700;">${m.month_name}</td>
                        <td style="text-align:center;font-weight:800;color:#4f46e5;">
                            ${m.inv_curr} <span style="color:#64748b;font-size:11px;font-weight:500;">(${posCurr} поз.)</span>
                        </td>
                        <td style="text-align:center;font-weight:700;color:#0f172a;" title="${uniqCurr} унікальних товарів">
                            ${posCurr} <span style="color:#7c3aed;font-size:11px;font-weight:600;">(${uniqCurr} ун.)</span>
                        </td>
                        <td style="text-align:center;color:var(--text-muted);">${m.inv_prev}</td>
                        <td style="text-align:center;"><span class="badge ${growthClass}">${growthStr}</span></td>
                        <td style="text-align:right;">
                            <a href="${monthUrl}" class="month-btn">📄 Накладные (${m.inv_curr}) ➔</a>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });

                // Итоговая строка
                if (monthly.length > 0) {
                    const totalInvCurr = kpi.invoices_curr || 0;
                    const totalInvPrev = kpi.invoices_prev || 0;
                    const totalGrowthStr = kpi.growth_yoy_pct !== null && kpi.growth_yoy_pct !== undefined ? fmtPct(kpi.growth_yoy_pct) : '—';
                    const totalGrowthClass = kpi.growth_yoy_pct !== null && kpi.growth_yoy_pct >= 100 ? 'badge-positive' : (kpi.growth_yoy_pct !== null ? 'badge-negative' : 'badge-neutral');

                    tbody.innerHTML += `
                        <tr style="background:#f8fafc;font-weight:800;border-top:2px solid var(--border);">
                            <td>📊 Итого за год:</td>
                            <td style="text-align:center;color:#4f46e5;">${totalInvCurr} <span style="color:#64748b;font-size:11px;font-weight:500;">(${posVal} поз.)</span></td>
                            <td style="text-align:center;color:#0f172a;">${posVal} <span style="color:#7c3aed;font-size:11px;font-weight:600;">(${uniqVal} ун.)</span></td>
                            <td style="text-align:center;color:var(--text-muted);">${totalInvPrev}</td>
                            <td style="text-align:center;"><span class="badge ${totalGrowthClass}">${totalGrowthStr}</span></td>
                            <td></td>
                        </tr>
                    `;
                }

                // Chart
                if (chartInstance) chartInstance.destroy();
                const ctx = document.getElementById('chart-invoices-bar').getContext('2d');
                chartInstance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: monthLabels,
                        datasets: [
                            { label: `Накладные ${year}`, data: currCounts, backgroundColor: '#4f46e5', borderRadius: 4 },
                            { label: `Накладные ${year - 1}`, data: prevCounts, backgroundColor: '#94a3b8', borderRadius: 4 }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { labels: { color: '#475569', font: { family: 'Inter', size: 12, weight: 600 } } } },
                        scales: {
                            x: { grid: { color: '#e2e8f0' }, ticks: { color: '#64748b', font: { family: 'Inter', size: 11 } } },
                            y: { grid: { color: '#e2e8f0' }, ticks: { color: '#64748b', font: { family: 'Inter', size: 11 } } }
                        }
                    }
                });

            } catch (err) {
                console.error('Error loading invoices analytics:', err);
            }
        }
    </script>
</body>
</html>
