<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🏆 UTSK — Аналитика отрасли-лидера и концентрации</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        :root {
            --bg-main: #f8fafc;
            --bg-card: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --border-light: #f1f5f9;
            --brand: #0284c7;
            --brand-light: #e0f2fe;
            --accent: #8b5cf6;
            --good: #10b981;
            --warn: #f59e0b;
            --danger: #ef4444;
            --gold: #eab308;
            --radius-lg: 16px;
            --radius-md: 12px;
            --radius-sm: 8px;
            --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.05);
            --shadow-md: 0 4px 12px rgba(15, 23, 42, 0.08);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-main);
            color: var(--text-main);
            min-height: 100vh;
            padding: 24px;
            line-height: 1.5;
        }

        .container { max-width: 1600px; margin: 0 auto; }

        .page-header {
            background: var(--bg-card);
            padding: 20px 24px;
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .header-title-area { display: flex; align-items: center; gap: 14px; }
        .header-icon {
            width: 48px; height: 48px; border-radius: 12px;
            background: #fef9c3; color: #ca8a04;
            display: flex; align-items: center; justify-content: center;
            font-size: 24px;
        }
        .header-title h1 { font-size: 22px; font-weight: 800; color: var(--text-main); }
        .header-title p { font-size: 13px; color: var(--text-muted); margin-top: 2px; }

        .header-controls { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
        .select-year {
            padding: 9px 16px; border: 1px solid var(--border);
            border-radius: var(--radius-md); background: var(--bg-card);
            font-weight: 600; font-size: 14px; cursor: pointer; color: var(--text-main);
        }
        .btn-nav {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 9px 16px; border-radius: var(--radius-md);
            font-size: 13px; font-weight: 600; text-decoration: none;
            background: #f1f5f9; color: var(--text-main); border: 1px solid var(--border);
            transition: all 0.15s;
        }
        .btn-nav:hover { background: var(--brand-light); color: var(--brand); border-color: #bae6fd; }
        .btn-nav.primary { background: #ca8a04; color: white; border-color: #ca8a04; }
        .btn-nav.primary:hover { background: #a16207; }

        /* KPI Grid */
        .kpi-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px; margin-bottom: 24px;
        }
        .kpi-card {
            background: var(--bg-card); border-radius: var(--radius-lg);
            padding: 20px; border: 1px solid var(--border);
            box-shadow: var(--shadow-sm); position: relative; overflow: hidden;
        }
        .kpi-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
            background: var(--gold);
        }
        .kpi-card.gold::before { background: #eab308; }
        .kpi-card.blue::before { background: var(--brand); }
        .kpi-card.purple::before { background: var(--accent); }
        .kpi-card.green::before { background: var(--good); }
        .kpi-card.amber::before { background: var(--warn); }

        .kpi-label {
            font-size: 12px; font-weight: 700; color: var(--text-muted);
            text-transform: uppercase; letter-spacing: 0.5px;
            margin-bottom: 8px; display: flex; align-items: center; gap: 8px;
        }
        .kpi-value {
            font-family: 'JetBrains Mono', monospace; font-size: 22px; font-weight: 800;
            color: var(--text-main); line-height: 1.2;
        }
        .kpi-sub { font-size: 12px; color: var(--text-muted); margin-top: 6px; }

        /* Concentration Banner */
        .concentration-banner {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            border-radius: var(--radius-lg);
            padding: 22px 28px;
            color: white;
            margin-bottom: 24px;
            display: flex;
            justify-content: space-around;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            box-shadow: var(--shadow-md);
        }
        .concentration-item { text-align: center; }
        .concentration-item .title { font-size: 12px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
        .concentration-item .val { font-family: 'JetBrains Mono', monospace; font-size: 26px; font-weight: 800; color: #38bdf8; }
        .concentration-item .note { font-size: 12px; color: #cbd5e1; margin-top: 2px; }

        /* Charts Row */
        .grid-2 {
            display: grid; grid-template-columns: 1fr 1.3fr; gap: 20px; margin-bottom: 24px;
        }
        @media (max-width: 1024px) { .grid-2 { grid-template-columns: 1fr; } }

        .card {
            background: var(--bg-card); border-radius: var(--radius-lg);
            border: 1px solid var(--border); padding: 22px;
            box-shadow: var(--shadow-sm);
        }
        .card-header {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 16px;
        }
        .card-title {
            font-size: 16px; font-weight: 700; display: flex; align-items: center; gap: 10px;
        }
        .chart-box { position: relative; height: 350px; }

        /* Tables */
        .table-responsive { overflow-x: auto; margin-top: 8px; }
        .data-table {
            width: 100%; border-collapse: collapse; font-size: 13px;
        }
        .data-table th {
            text-align: left; padding: 12px 14px;
            background: #f8fafc; color: var(--text-muted);
            font-weight: 700; font-size: 11px; text-transform: uppercase;
            letter-spacing: 0.5px; border-bottom: 2px solid var(--border);
            white-space: nowrap;
        }
        .data-table td {
            padding: 12px 14px; border-bottom: 1px solid var(--border-light);
            vertical-align: middle;
        }
        .data-table tr:hover td { background: #f8fafc; }
        .num { font-family: 'JetBrains Mono', monospace; text-align: right; }
        .rank-badge {
            display: inline-flex; align-items: center; justify-content: center;
            width: 22px; height: 22px; border-radius: 50%; font-size: 11px; font-weight: 700;
        }
        .rank-1 { background: #fef08a; color: #854d0e; }
        .rank-2 { background: #e2e8f0; color: #334155; }
        .rank-3 { background: #ffedd5; color: #9a3412; }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <header class="page-header">
            <div class="header-title-area">
                <div class="header-icon">🏆</div>
                <div class="header-title">
                    <h1>Аналитика отрасли-лидера и концентрации</h1>
                    <p>Рейтинги лидерства, концентрация объёмов ТОП-3 / ТОП-5 и рыночный индекс HHI</p>
                </div>
            </div>
            <div class="header-controls">
                <select id="yearSelect" class="select-year" onchange="onYearChange()">
                    <option value="2026">2026 год</option>
                    <option value="2025">2025 год</option>
                    <option value="2024">2024 год</option>
                </select>
                <a href="#" id="backToDirectionsBtn" class="btn-nav primary">← К направлениям</a>
                <a href="/?token=utsk2026" class="btn-nav">🏠 Дашборд</a>
            </div>
        </header>

        <!-- KPI Cards -->
        <section class="kpi-grid">
            <div class="kpi-card gold">
                <div class="kpi-label"><i class="fa-solid fa-sack-dollar"></i> Лидер по выручке</div>
                <div class="kpi-value" id="kpi-rev-leader">—</div>
                <div class="kpi-sub" id="kpi-rev-leader-sub">Доля в продажах</div>
            </div>
            <div class="kpi-card purple">
                <div class="kpi-label"><i class="fa-solid fa-users"></i> Лидер по клиентам</div>
                <div class="kpi-value" id="kpi-cli-leader">—</div>
                <div class="kpi-sub" id="kpi-cli-leader-sub">Доля покупателей</div>
            </div>
            <div class="kpi-card blue">
                <div class="kpi-label"><i class="fa-solid fa-truck-ramp-box"></i> Лидер по накладным</div>
                <div class="kpi-value" id="kpi-inv-leader">—</div>
                <div class="kpi-sub" id="kpi-inv-leader-sub">Доля документов</div>
            </div>
            <div class="kpi-card green">
                <div class="kpi-label"><i class="fa-solid fa-hand-holding-dollar"></i> Лидер по ср. чеку</div>
                <div class="kpi-value" id="kpi-avg-leader">—</div>
                <div class="kpi-sub" id="kpi-avg-leader-sub">Крупнейший размер сделки</div>
            </div>
            <div class="kpi-card amber">
                <div class="kpi-label"><i class="fa-solid fa-scale-balanced"></i> Индекс Херфиндаля (HHI)</div>
                <div class="kpi-value" id="kpi-hhi">—</div>
                <div class="kpi-sub" id="kpi-hhi-sub">Уровень рыночной концентрации</div>
            </div>
        </section>

        <!-- Executive Concentration Banner -->
        <div class="concentration-banner">
            <div class="concentration-item">
                <div class="title">Выручка ТОП-3 отраслей</div>
                <div class="val" id="banner-rev-top3">—</div>
                <div class="note">Крупнейшие 3 отрасли</div>
            </div>
            <div class="concentration-item">
                <div class="title">Выручка ТОП-5 отраслей</div>
                <div class="val" id="banner-rev-top5">—</div>
                <div class="note">92% товарного оборота</div>
            </div>
            <div class="concentration-item">
                <div class="title">Клиентов в ТОП-3</div>
                <div class="val" id="banner-cli-top3">—</div>
                <div class="note">Концентрация клиентской базы</div>
            </div>
            <div class="concentration-item">
                <div class="title">Накладных в ТОП-3</div>
                <div class="val" id="banner-inv-top3">—</div>
                <div class="note">Концентрация документооборота</div>
            </div>
        </div>

        <!-- Charts Row -->
        <section class="grid-2">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title"><i class="fa-solid fa-chart-pie" style="color:var(--gold)"></i> Концентрация выручки TOP-5</h3>
                    <span id="chartYearTag" style="font-size:12px;color:var(--text-muted);">2026 год</span>
                </div>
                <div class="chart-box">
                    <canvas id="chartTop5Pie"></canvas>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h3 class="card-title"><i class="fa-solid fa-chart-bar" style="color:var(--brand)"></i> Сравнение долей: Выручка vs Клиенты vs Накладные</h3>
                    <span style="font-size:12px;color:var(--text-muted);">ТОП-6 отраслей (%)</span>
                </div>
                <div class="chart-box">
                    <canvas id="chartComparisonBar"></canvas>
                </div>
            </div>
        </section>

        <!-- Table: Comprehensive Direction Ranking -->
        <section class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fa-solid fa-ranking-star" style="color:var(--gold)"></i> Полная матрица показателей отраслей и ранжирование</h3>
                <span id="tableDirsSub" style="font-size:13px;color:var(--text-muted);">14 отраслей</span>
            </div>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width: 30px;">Ранг</th>
                            <th>Отрасль</th>
                            <th class="num">Выручка</th>
                            <th class="num">Доля выр.</th>
                            <th class="num">Клиентов</th>
                            <th class="num">Доля кл.</th>
                            <th class="num">Ранг кл.</th>
                            <th class="num">Накладных</th>
                            <th class="num">Доля накл.</th>
                            <th class="num">Ранг накл.</th>
                            <th class="num">Ср. чек</th>
                            <th class="num">Выручка / кл.</th>
                        </tr>
                    </thead>
                    <tbody id="leadersTbody">
                        <tr><td colspan="12" style="text-align:center;padding:24px;color:var(--text-muted);">Загрузка матрицы...</td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const TOKEN = urlParams.get('token') || 'utsk2026';
        let currentYear = parseInt(urlParams.get('year')) || 2026;

        let top5PieChart = null;
        let comparisonBarChart = null;

        function fmtM(val) {
            if (!val || isNaN(val)) return '0 ₴';
            const v = parseFloat(val);
            if (Math.abs(v) >= 1000000) {
                return (v / 1000000).toLocaleString('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' млн ₴';
            }
            return Math.round(v).toLocaleString('ru-RU') + ' ₴';
        }

        function fmtNum(val) {
            if (!val || isNaN(val)) return '0';
            return parseInt(val).toLocaleString('ru-RU');
        }

        function fmtPct(val) {
            if (!val || isNaN(val)) return '0.0%';
            return parseFloat(val).toFixed(1) + '%';
        }

        function onYearChange() {
            currentYear = parseInt(document.getElementById('yearSelect').value);
            window.location.href = `/directions-leader-analytics?token=${TOKEN}&year=${currentYear}`;
        }

        async function loadLeaderAnalytics() {
            try {
                document.getElementById('backToDirectionsBtn').href = `/directions-analytics?token=${TOKEN}&year=${currentYear}`;
                document.getElementById('yearSelect').value = currentYear;
                document.getElementById('chartYearTag').textContent = `${currentYear} год`;

                const res = await fetch(`/api/analytics/directions/leader-analytics?token=${TOKEN}&year=${currentYear}`);
                const json = await res.json();
                if (json.status !== 'ok' || !json.data) {
                    throw new Error('Не удалось загрузить данные');
                }
                renderDashboard(json.data);
            } catch (err) {
                console.error(err);
                document.getElementById('leadersTbody').innerHTML = `<tr><td colspan="12" style="text-align:center;color:var(--danger);padding:20px;">⚠️ Ошибка: ${err.message}</td></tr>`;
            }
        }

        function renderDashboard(data) {
            const leaders = data.leaders || [];
            const conc = data.concentration || [];
            const topConc = data.top_concentration || {};

            const revLeader = leaders.find(l => l.metric === 'revenue') || {};
            const cliLeader = leaders.find(l => l.metric === 'clients') || {};
            const invLeader = leaders.find(l => l.metric === 'invoices') || {};
            const avgLeader = leaders.find(l => l.metric === 'avg_check') || {};

            // KPI
            document.getElementById('kpi-rev-leader').textContent = `${revLeader.icon || '🌐'} ${(revLeader.direction_name || '').split('/')[0]}`;
            document.getElementById('kpi-rev-leader-sub').textContent = `${fmtPct(revLeader.pct)} (${fmtM(revLeader.value)})`;

            document.getElementById('kpi-cli-leader').textContent = `${cliLeader.icon || '🌐'} ${(cliLeader.direction_name || '').split('/')[0]}`;
            document.getElementById('kpi-cli-leader-sub').textContent = `${fmtPct(cliLeader.pct)} (${fmtNum(cliLeader.value)} кл.)`;

            document.getElementById('kpi-inv-leader').textContent = `${invLeader.icon || '🌐'} ${(invLeader.direction_name || '').split('/')[0]}`;
            document.getElementById('kpi-inv-leader-sub').textContent = `${fmtPct(invLeader.pct)} (${fmtNum(invLeader.value)} накл.)`;

            document.getElementById('kpi-avg-leader').textContent = `${avgLeader.icon || '🌐'} ${(avgLeader.direction_name || '').split('/')[0]}`;
            document.getElementById('kpi-avg-leader-sub').textContent = `${fmtM(avgLeader.value)} ср. чек`;

            const hhi = topConc.hhi_index || 0;
            document.getElementById('kpi-hhi').textContent = hhi.toLocaleString('ru-RU');
            document.getElementById('kpi-hhi-sub').textContent = hhi > 2500 ? 'Высокая концентрация' : (hhi > 1500 ? 'Умеренная концентрация' : 'Низкая концентрация');

            // Banner
            document.getElementById('banner-rev-top3').textContent = fmtPct(topConc.rev_top3_pct);
            document.getElementById('banner-rev-top5').textContent = fmtPct(topConc.rev_top5_pct);
            document.getElementById('banner-cli-top3').textContent = fmtPct(topConc.cli_top3_pct);
            document.getElementById('banner-inv-top3').textContent = fmtPct(topConc.inv_top3_pct);
            document.getElementById('tableDirsSub').textContent = `${conc.length} активных отраслей`;

            // Charts
            renderTop5Pie(conc);
            renderComparisonBar(conc);

            // Table
            renderLeadersTable(conc);
        }

        function renderTop5Pie(conc) {
            const ctx = document.getElementById('chartTop5Pie').getContext('2d');
            if (top5PieChart) top5PieChart.destroy();

            const top5 = conc.slice(0, 5);
            const otherRev = conc.slice(5).reduce((acc, d) => acc + d.revenue, 0);

            const labels = top5.map(d => `${d.icon} ${d.direction_name}`);
            const values = top5.map(d => d.revenue);
            const colors = top5.map(d => d.color);

            if (otherRev > 0) {
                labels.push('🌐 Прочие отрасли');
                values.push(otherRev);
                colors.push('#94a3b8');
            }

            top5PieChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: values,
                        backgroundColor: colors,
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right', labels: { boxWidth: 12, padding: 8, font: { size: 11 } } },
                        tooltip: {
                            callbacks: {
                                label: function(ctx) {
                                    const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                                    const val = ctx.raw || 0;
                                    const pct = total > 0 ? ((val / total) * 100).toFixed(1) : 0;
                                    return ` ${fmtM(val)} (${pct}%)`;
                                }
                            }
                        }
                    },
                    cutout: '60%'
                }
            });
        }

        function renderComparisonBar(conc) {
            const ctx = document.getElementById('chartComparisonBar').getContext('2d');
            if (comparisonBarChart) comparisonBarChart.destroy();

            const top6 = conc.slice(0, 6);
            const labels = top6.map(d => `${d.icon} ${d.direction_name.split('/')[0]}`);

            comparisonBarChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Выручка (%)',
                            data: top6.map(d => d.revenue_pct),
                            backgroundColor: '#eab308',
                            borderRadius: 4
                        },
                        {
                            label: 'Клиенты (%)',
                            data: top6.map(d => d.clients_pct),
                            backgroundColor: '#8b5cf6',
                            borderRadius: 4
                        },
                        {
                            label: 'Накладные (%)',
                            data: top6.map(d => d.invoices_pct),
                            backgroundColor: '#0284c7',
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { boxWidth: 12, padding: 10, font: { size: 12 } } },
                        tooltip: {
                            callbacks: {
                                label: ctx => ` ${ctx.dataset.label}: ${ctx.raw}%`
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { callback: v => v + '%' },
                            grid: { color: '#f1f5f9' }
                        },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        function renderLeadersTable(conc) {
            const tbody = document.getElementById('leadersTbody');
            if (!conc || conc.length === 0) {
                tbody.innerHTML = '<tr><td colspan="12" style="text-align:center;padding:24px;">Нет данных</td></tr>';
                return;
            }

            function getRankClass(rank) {
                if (rank === 1) return 'rank-1';
                if (rank === 2) return 'rank-2';
                if (rank === 3) return 'rank-3';
                return '';
            }

            tbody.innerHTML = conc.map(d => `
                <tr>
                    <td style="text-align:center;">
                        <span class="rank-badge ${getRankClass(d.rank_revenue)}">${d.rank_revenue}</span>
                    </td>
                    <td>
                        <div style="display:flex;align-items:center;gap:10px;">
                            <span style="font-size:18px;">${d.icon}</span>
                            <strong>${d.direction_name}</strong>
                        </div>
                    </td>
                    <td class="num" style="font-weight:700;color:#ca8a04;">${fmtM(d.revenue)}</td>
                    <td class="num" style="font-weight:700;">${fmtPct(d.revenue_pct)}</td>
                    <td class="num">${fmtNum(d.clients_count)}</td>
                    <td class="num">${fmtPct(d.clients_pct)}</td>
                    <td class="num" style="color:var(--text-muted);font-weight:600;">#${d.rank_clients}</td>
                    <td class="num">${fmtNum(d.invoices_count)}</td>
                    <td class="num">${fmtPct(d.invoices_pct)}</td>
                    <td class="num" style="color:var(--text-muted);font-weight:600;">#${d.rank_invoices}</td>
                    <td class="num" style="font-weight:600;color:#4f46e5;">${fmtM(d.avg_check)}</td>
                    <td class="num" style="font-weight:600;color:var(--good);">${fmtM(d.avg_rev_per_client)}</td>
                </tr>
            `).join('');
        }

        window.addEventListener('DOMContentLoaded', loadLeaderAnalytics);
