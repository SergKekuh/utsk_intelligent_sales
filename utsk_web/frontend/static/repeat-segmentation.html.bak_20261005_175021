<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UTSK — Повторні (розкладені) деталізація</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg-app: #f8fafc;
            --bg-surface: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --primary: #4f46e5;
            --primary-light: #eef2ff;
            --radius-lg: 16px;
            --radius-md: 10px;
            --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.05);
            --shadow-md: 0 4px 12px rgba(15, 23, 42, 0.06);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-app);
            color: var(--text-main);
            line-height: 1.5;
            padding: 24px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* Top Header */
        .top-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--bg-surface);
            padding: 20px 24px;
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .header-title-area {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #f1f5f9;
            color: var(--text-main);
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 13.5px;
            transition: all 0.2s ease;
            border: 1px solid var(--border);
            cursor: pointer;
        }

        .btn-action:hover {
            background: #e2e8f0;
            transform: translateY(-1px);
        }

        .btn-primary {
            background: #4f46e5;
            color: #ffffff;
            border-color: #4338ca;
        }

        .btn-primary:hover {
            background: #4338ca;
            color: #ffffff;
        }

        .header-info h1 {
            font-size: 22px;
            font-weight: 800;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .header-info .meta {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 3px;
            font-weight: 500;
        }

        .meta-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: #eef2ff;
            padding: 2px 8px;
            border-radius: 6px;
            font-weight: 600;
            color: #4338ca;
        }

        /* 6 KPI Grid */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 14px;
            margin-bottom: 24px;
        }

        .kpi-card {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 16px;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

        .kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .kpi-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
        }

        .kpi-lbl {
            font-size: 11px;
            text-transform: uppercase;
            font-weight: 700;
            color: var(--text-muted);
            letter-spacing: 0.3px;
        }

        .kpi-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        .kpi-val {
            font-size: 20px;
            font-weight: 900;
            color: var(--text-main);
        }

        .kpi-sub {
            font-size: 11.5px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        /* Subgroup Filter Buttons */
        .cohort-nav-card {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 16px 20px;
            box-shadow: var(--shadow-sm);
            margin-bottom: 24px;
        }

        .cohort-nav-title {
            font-size: 13px;
            font-weight: 800;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .cohort-buttons-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .cohort-btn {
            background: #f8fafc;
            border: 1px solid var(--border);
            padding: 9px 18px;
            border-radius: 10px;
            font-family: inherit;
            font-size: 13.5px;
            font-weight: 700;
            color: #334155;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.15s ease;
        }

        .cohort-btn:hover {
            background: #eef2ff;
            border-color: #c7d2fe;
            color: #4338ca;
        }

        .cohort-btn.active {
            background: #4f46e5;
            color: #ffffff;
            border-color: #4338ca;
            box-shadow: 0 2px 6px rgba(79, 70, 229, 0.25);
        }

        .cohort-badge {
            background: rgba(0, 0, 0, 0.08);
            padding: 2px 7px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 800;
        }

        .cohort-btn.active .cohort-badge {
            background: rgba(255, 255, 255, 0.25);
            color: #ffffff;
        }

        /* 2 Charts Grid */
        .charts-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        .bento-card {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 20px;
            box-shadow: var(--shadow-sm);
        }

        .bento-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 1px solid #f1f5f9;
        }

        .bento-card-title {
            font-size: 15.5px;
            font-weight: 800;
            color: #1e293b;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .bento-card-subtitle {
            font-size: 12.5px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        /* Filter Controls Bar */
        .filters-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

        .filters-left {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .search-box {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #f8fafc;
            border: 1px solid var(--border);
            padding: 8px 14px;
            border-radius: 10px;
            width: 280px;
        }

        .search-box input {
            border: none;
            background: transparent;
            font-family: inherit;
            font-size: 13.5px;
            color: var(--text-main);
            width: 100%;
            outline: none;
        }

        .select-filter {
            background: #f8fafc;
            border: 1px solid var(--border);
            padding: 8px 12px;
            border-radius: 10px;
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-main);
            outline: none;
            cursor: pointer;
        }

        .table-counter-box {
            font-size: 13px;
            font-weight: 700;
            color: var(--text-muted);
        }

        /* Table */
        .detail-table-wrap {
            overflow-x: auto;
            border: 1px solid var(--border);
            border-radius: 12px;
        }

        .detail-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            font-family: inherit;
            text-align: left;
        }

        .detail-table th {
            background: #f1f5f9;
            color: #334155;
            font-weight: 700;
            padding: 12px 14px;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        .detail-table td {
            padding: 11px 14px;
            border-bottom: 1px solid #f1f5f9;
            color: var(--text-main);
            vertical-align: middle;
        }

        .detail-table tr:hover td {
            background: #f8fafc;
        }

        .client-code-badge {
            display: inline-block;
            background: #eef2ff;
            color: #4338ca;
            padding: 2px 7px;
            border-radius: 6px;
            font-weight: 700;
            font-size: 12px;
            text-decoration: none;
            border: 1px solid #c7d2fe;
        }

        .client-row-link {
            text-decoration: none;
            color: #0f172a;
            font-weight: 600;
            transition: color 0.15s ease;
        }

        .client-row-link:hover {
            color: #4f46e5;
            text-decoration: underline;
        }

        /* Badges */
        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .badge-a1 { background: #d1fae5; color: #065f46; }
        .badge-a2 { background: #d1fae5; color: #047857; }
        .badge-a3 { background: #d1fae5; color: #0f766e; }
        .badge-b1 { background: #fef3c7; color: #92400e; }
        .badge-b2 { background: #fef3c7; color: #b45309; }
        .badge-c1 { background: #f1f5f9; color: #475569; }
        .badge-c2 { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }

        .badge-subgroup {
            background: #f1f5f9;
            color: #334155;
        }
        .badge-subgroup.QUICK_DOUBLE { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
        .badge-subgroup.CENTER { background: #e0e7ff; color: #3730a3; border: 1px solid #c7d2fe; }
        .badge-subgroup.CANDIDATES { background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; }

        .badge-days {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 7px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            background: #f8fafc;
            color: #475569;
            border: 1px solid #e2e8f0;
        }

        .text-right { text-align: right !important; }
        .text-center { text-align: center !important; }

        /* Quick View Modal */
        .modal-backdrop {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(4px);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .modal-backdrop.active { display: flex; }

        .modal-card {
            background: #ffffff;
            border-radius: 16px;
            max-width: 580px;
            width: 100%;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
            border: 1px solid #e2e8f0;
            overflow: hidden;
            animation: modalFadeIn 0.2s ease-out;
        }
        @keyframes modalFadeIn {
            from { opacity: 0; transform: translateY(12px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .modal-header {
            padding: 18px 24px;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f8fafc;
        }

        .modal-title {
            font-size: 17px;
            font-weight: 800;
            color: #0f172a;
        }

        .modal-close {
            background: none;
            border: none;
            font-size: 24px;
            color: #94a3b8;
            cursor: pointer;
            line-height: 1;
        }

        .modal-close:hover { color: #0f172a; }

        .modal-body { padding: 24px; }

        .modal-stat-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 16px;
        }

        .modal-stat-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 12px 14px;
        }

        .modal-stat-box.highlight {
            grid-column: 1 / -1;
            background: #eef2ff;
            border-color: #c7d2fe;
        }

        .modal-stat-lbl {
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
        }

        .modal-stat-val {
            font-size: 18px;
            font-weight: 800;
            color: #0f172a;
            margin-top: 4px;
        }

        .modal-footer {
            padding: 14px 24px;
            border-top: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f8fafc;
        }

        @media (max-width: 1200px) {
            .kpi-grid { grid-template-columns: repeat(3, 1fr); }
            .charts-grid { grid-template-columns: 1fr; }
        }

        @media (max-width: 768px) {
            body { padding: 12px; }
            .kpi-grid { grid-template-columns: 1fr 1fr; }
            .top-header { flex-direction: column; align-items: flex-start; }
            .search-box { width: 100%; }
        }
    </style>
</head>
<body>

    <div class="container">

        <!-- Top Header -->
        <div class="top-header">
            <div class="header-title-area">
                <button class="btn-action" onclick="goBack()">
                    <i class="fa-solid fa-arrow-left"></i> До матриці
                </button>
                <div class="header-info">
                    <h1><i class="fa-solid fa-repeat" style="color:#4f46e5;"></i> Повторні (розкладені) — Детальний аналіз 174 компаній</h1>
                    <div class="meta">
                        Рік: <span class="meta-pill" id="lbl-year">2026</span> &nbsp;|&nbsp; 
                        База: <span class="meta-pill">174 повторних клієнти (2-3 покупки)</span> &nbsp;|&nbsp; 
                        БД: <span class="meta-pill">PostgreSQL (bd_intelligent_sales)</span>
                    </div>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
                <button class="btn-action btn-primary" onclick="exportToCSV()">
                    <i class="fa-solid fa-file-csv"></i> Експорт у CSV
                </button>
            </div>
        </div>

        <!-- 6 KPI Cards -->
        <div class="kpi-grid">
            <!-- 1. Всього повторних -->
            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-lbl">Всього повторних</span>
                    <div class="kpi-icon" style="background:#eef2ff;color:#4f46e5;"><i class="fa-solid fa-users"></i></div>
                </div>
                <div class="kpi-val" id="kpi-total-repeat">174</div>
                <div class="kpi-sub">Клієнти з 2-3 накладними</div>
            </div>

            <!-- 2. Швидкий дубль (2) -->
            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-lbl">Швидкий дубль (2)</span>
                    <div class="kpi-icon" style="background:#fffbeb;color:#d97706;"><i class="fa-solid fa-bolt"></i></div>
                </div>
                <div class="kpi-val" id="kpi-dubl-count" style="color:#b45309;">25</div>
                <div class="kpi-sub">2 покупки (інтервал &le; 7 дн)</div>
            </div>

            <!-- 3. Центр (2-3) -->
            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-lbl">Центр (2-3)</span>
                    <div class="kpi-icon" style="background:#eff6ff;color:#2563eb;"><i class="fa-solid fa-bullseye"></i></div>
                </div>
                <div class="kpi-val" id="kpi-center-count" style="color:#1d4ed8;">87</div>
                <div class="kpi-sub">2 покупки (інтервал &gt; 7 дн)</div>
            </div>

            <!-- 4. Кандидати в постійні (3) -->
            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-lbl">Кандидати (3)</span>
                    <div class="kpi-icon" style="background:#ecfdf5;color:#10b981;"><i class="fa-solid fa-star"></i></div>
                </div>
                <div class="kpi-val" id="kpi-cand-count" style="color:#047857;">62</div>
                <div class="kpi-sub">3 оформлені покупки</div>
            </div>

            <!-- 5. Виручка повторних -->
            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-lbl">Виручка повторних</span>
                    <div class="kpi-icon" style="background:#fdf4ff;color:#a855f7;"><i class="fa-solid fa-sack-dollar"></i></div>
                </div>
                <div class="kpi-val" id="kpi-revenue">—</div>
                <div class="kpi-sub">Товарна виручка когорти</div>
            </div>

            <!-- 6. Накладних / Сер. чек -->
            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-lbl">Накладних / Чек</span>
                    <div class="kpi-icon" style="background:#f8fafc;color:#475569;"><i class="fa-solid fa-receipt"></i></div>
                </div>
                <div class="kpi-val" id="kpi-invoices">—</div>
                <div class="kpi-sub" id="kpi-avg-check">Сер. чек: —</div>
            </div>
        </div>

        <!-- Subgroup Filter Buttons -->
        <div class="cohort-nav-card">
            <div class="cohort-nav-title">
                <i class="fa-solid fa-filter"></i> Фільтр за структурою розкладання
            </div>
            <div class="cohort-buttons-wrap">
                <button class="cohort-btn active" onclick="selectSubgroup('ALL', this)">
                    Всі повторні <span class="cohort-badge" id="badge-all">174</span>
                </button>
                <button class="cohort-btn" onclick="selectSubgroup('QUICK_DOUBLE', this)">
                    ⚡ Швидкий дубль <span class="cohort-badge" id="badge-dubl">25</span>
                </button>
                <button class="cohort-btn" onclick="selectSubgroup('CENTER', this)">
                    🎯 Центр <span class="cohort-badge" id="badge-center">87</span>
                </button>
                <button class="cohort-btn" onclick="selectSubgroup('CANDIDATES', this)">
                    ⭐ Кандидати в постійні <span class="cohort-badge" id="badge-cand">62</span>
                </button>
            </div>
        </div>

        <!-- 2 Charts Grid -->
        <div class="charts-grid">
            <!-- Chart 1: Кількість за підгрупами -->
            <div class="bento-card">
                <div class="bento-card-header">
                    <div>
                        <h2 class="bento-card-title">
                            <i class="fa-solid fa-chart-pie" style="color:#4f46e5;"></i> Розподіл клієнтів за підгрупами
                        </h2>
                        <div class="bento-card-subtitle">Кількість компаній у кожній підгрупі повторних покупок</div>
                    </div>
                </div>
                <div style="height: 260px; width: 100%; position: relative;">
                    <canvas id="chartSubgroupsCount"></canvas>
                </div>
            </div>

            <!-- Chart 2: Виручка за підгрупами -->
            <div class="bento-card">
                <div class="bento-card-header">
                    <div>
                        <h2 class="bento-card-title">
                            <i class="fa-solid fa-chart-column" style="color:#10b981;"></i> Порівняння виручки за підгрупами
                        </h2>
                        <div class="bento-card-subtitle">Товарна виручка (млн ₴) за кожною категорією</div>
                    </div>
                </div>
                <div style="height: 260px; width: 100%; position: relative;">
                    <canvas id="chartSubgroupsRev"></canvas>
                </div>
            </div>
        </div>

        <!-- Companies Table Bento Card -->
        <div class="bento-card">
            <div class="bento-card-header">
                <div>
                    <h2 class="bento-card-title">
                        <i class="fa-solid fa-list-check" style="color:#0f172a;"></i> База компаній сегменту «Повторні (розкладені)»
                    </h2>
                    <div class="bento-card-subtitle">Клікніть на компанію для переходу в картку клієнта або 👁️ для швидкої інформації</div>
                </div>
            </div>

            <!-- Filters Bar -->
            <div class="filters-bar">
                <div class="filters-left">
                    <div class="search-box">
                        <i class="fa-solid fa-magnifying-glass" style="color:#94a3b8;"></i>
                        <input type="text" id="searchInput" placeholder="Пошук за кодом або назвою..." oninput="applyFilters()">
                    </div>

                    <select id="filterAbc" class="select-filter" onchange="applyFilters()">
                        <option value="ALL">Всі класи</option>
                        <option value="A1">🟢 Опорні A1 (&gt;8.7M ₴)</option>
                        <option value="A2">🟢 Опорні A2 (5.8-8.7M ₴)</option>
                        <option value="A3">🟢 Опорні A3 (4.35-5.8M ₴)</option>
                        <option value="B1">🟡 Розвиваючі B1 (2.9-4.35M ₴)</option>
                        <option value="B2">🟡 Розвиваючі B2 (1.45-2.9M ₴)</option>
                        <option value="C1">⚪ Підтримуючі C1 (435K-1.45M ₴)</option>
                        <option value="C2">💡 Лайт (&le;146K ₴)</option>
                    </select>

                    <select id="sortBy" class="select-filter" onchange="applyFilters()">
                        <option value="rev_desc">Сортування: Виручка (макс)</option>
                        <option value="rev_asc">Сортування: Виручка (мін)</option>
                        <option value="days_asc">Сортування: Дні між покупками (мін)</option>
                        <option value="days_desc">Сортування: Дні між покупками (макс)</option>
                        <option value="avg_desc">Сортування: Сер. чек (макс)</option>
                        <option value="name_asc">Сортування: Назва (А-Я)</option>
                    </select>
                </div>

                <div class="table-counter-box" id="tableCounter">
                    Показано 174 компанії
                </div>
            </div>

            <!-- Table -->
            <div class="detail-table-wrap">
                <table class="detail-table">
                    <thead>
                        <tr>
                            <th style="width: 40px;" class="text-center">#</th>
                            <th style="width: 90px;">Код 1С</th>
                            <th>Назва компанії</th>
                            <th style="width: 190px;">Підгрупа</th>
                            <th class="text-center" style="width: 90px;">Накладних</th>
                            <th class="text-right" style="width: 135px;">Виручка (₴)</th>
                            <th class="text-right" style="width: 125px;">Сер. чек (₴)</th>
                            <th class="text-center" style="width: 95px;">Клас</th>
                            <th class="text-center" style="width: 140px;">Дні між покупками</th>
                            <th>Галузь</th>
                            <th class="text-center" style="width: 80px;">Дія</th>
                        </tr>
                    </thead>
                    <tbody id="companiesTbody">
                        <tr>
                            <td colspan="11" style="text-align:center;padding:30px;color:#94a3b8;">
                                ⏳ Завантаження бази компаній з PostgreSQL...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- Quick View Modal -->
    <div id="companyModal" class="modal-backdrop" onclick="closeCompanyModal(event)">
        <div class="modal-card" onclick="event.stopPropagation()">
            <div class="modal-header">
                <div>
                    <h3 class="modal-title" id="modalCompName">Назва компанії</h3>
                    <div style="font-size:12px;color:#64748b;margin-top:2px;">Код 1С: <strong id="modalCompCode">—</strong></div>
                </div>
                <button class="modal-close" onclick="closeCompanyModal()">&times;</button>
            </div>
            <div class="modal-body">
                <div class="modal-stat-grid">
                    <div class="modal-stat-box highlight">
                        <div class="modal-stat-lbl">Товарна виручка</div>
                        <div class="modal-stat-val" id="modalRevenue" style="color:#4f46e5;">—</div>
                    </div>
                    <div class="modal-stat-box">
                        <div class="modal-stat-lbl">Підгрупа</div>
                        <div class="modal-stat-val" id="modalSubgroup" style="font-size:14px;">—</div>
                    </div>
                    <div class="modal-stat-box">
                        <div class="modal-stat-lbl">Кількість накладних</div>
                        <div class="modal-stat-val" id="modalInvoices">—</div>
                    </div>
                    <div class="modal-stat-box">
                        <div class="modal-stat-lbl">Середній чек</div>
                        <div class="modal-stat-val" id="modalAvgTicket">—</div>
                    </div>
                    <div class="modal-stat-box">
                        <div class="modal-stat-lbl">Дні між покупками</div>
                        <div class="modal-stat-val" id="modalDays">—</div>
                    </div>
                    <div class="modal-stat-box">
                        <div class="modal-stat-lbl">Клас</div>
                        <div class="modal-stat-val" id="modalAbc">—</div>
                    </div>
                    <div class="modal-stat-box">
                        <div class="modal-stat-lbl">Галузь діяльності</div>
                        <div class="modal-stat-val" id="modalIndustry" style="font-size:14px;">—</div>
                    </div>
                    <div class="modal-stat-box">
                        <div class="modal-stat-lbl">Статус клієнта</div>
                        <div class="modal-stat-val" id="modalStatus" style="font-size:14px;">—</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-action" onclick="closeCompanyModal()">Закрити</button>
                <a id="modalCardLink" href="#" class="btn-action btn-primary">
                    Перейти до повної картки клієнта <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <script>
        var TOKEN = new URLSearchParams(window.location.search).get('token') || 'utsk2026';
        var curYear = parseInt(new URLSearchParams(window.location.search).get('year')) || 2026;
        var selectedSubgroup = 'ALL';

        var allCompanies = [];
        var filteredCompanies = [];
        var chartSubgroupsCountInstance = null;
        var chartSubgroupsRevInstance = null;

        function fmtN(n) {
            if (n === null || n === undefined || isNaN(n)) return '0';
            return Number(n).toLocaleString('ru-RU');
        }

        function fmtM(n) {
            if (n === null || n === undefined || isNaN(n)) return '0 ₴';
            return Number(n).toLocaleString('ru-RU', { maximumFractionDigits: 0 }) + ' ₴';
        }

        function goBack() {
            var url = '/analytics?token=' + encodeURIComponent(TOKEN);
            window.location.href = url;
        }

        function getAbcBadge(abc) {
            var cls = 'badge-c2';
            if (abc === 'A1') cls = 'badge-a1';
            else if (abc === 'A2') cls = 'badge-a2';
            else if (abc === 'A3') cls = 'badge-a3';
            else if (abc === 'B1') cls = 'badge-b1';
            else if (abc === 'B2') cls = 'badge-b2';
            else if (abc === 'C1') cls = 'badge-c1';
            return '<span class="badge ' + cls + '">' + (abc === 'C2' || !abc ? '💡 Лайт' : abc) + '</span>';
        }

        function getSubgroupBadge(subgroup, subgroupKey) {
            var k = subgroupKey || 'CENTER';
            return '<span class="badge badge-subgroup ' + k + '">' + (subgroup || 'Центр (2-3)') + '</span>';
        }

        function updateKPIs(kpiData) {
            var totalRevenue = (kpiData && kpiData.total_revenue !== undefined)
                ? kpiData.total_revenue
                : allCompanies.reduce(function(sum, c) { return sum + (c.goods_revenue || 0); }, 0);

            var totalInvoices = (kpiData && kpiData.total_invoices !== undefined)
                ? kpiData.total_invoices
                : allCompanies.reduce(function(sum, c) { return sum + (c.invoices_count || c.inv_count || 0); }, 0);

            var avgTicket = (kpiData && kpiData.avg_ticket !== undefined)
                ? kpiData.avg_ticket
                : (totalInvoices > 0 ? totalRevenue / totalInvoices : 0);

            var totalRepeat = (kpiData && kpiData.total_repeat !== undefined) ? kpiData.total_repeat : allCompanies.length;
            var dublCount = (kpiData && kpiData.quick_double !== undefined) ? kpiData.quick_double : 25;
            var centerCount = (kpiData && kpiData.center !== undefined) ? kpiData.center : 87;
            var candCount = (kpiData && kpiData.candidates !== undefined) ? kpiData.candidates : 62;

            var elTot = document.getElementById('kpi-total-repeat'); if (elTot) elTot.textContent = fmtN(totalRepeat);
            var elDubl = document.getElementById('kpi-dubl-count'); if (elDubl) elDubl.textContent = fmtN(dublCount);
            var elCenter = document.getElementById('kpi-center-count'); if (elCenter) elCenter.textContent = fmtN(centerCount);
            var elCand = document.getElementById('kpi-cand-count'); if (elCand) elCand.textContent = fmtN(candCount);

            var elRev = document.getElementById('kpi-revenue'); if (elRev) elRev.textContent = fmtM(totalRevenue);
            var elInv = document.getElementById('kpi-invoices'); if (elInv) elInv.textContent = fmtN(totalInvoices) + ' накл.';
            var elAvg = document.getElementById('kpi-avg-check'); if (elAvg) elAvg.textContent = 'Сер. чек: ' + fmtM(avgTicket);
        }

        function updateSubgroupButtons(counts) {
            var sc = counts || {};
            var bAll = document.getElementById('badge-all'); if (bAll) bAll.textContent = fmtN(sc.ALL || allCompanies.length);
            var bDubl = document.getElementById('badge-dubl'); if (bDubl) bDubl.textContent = fmtN(sc.QUICK_DOUBLE || 25);
            var bCenter = document.getElementById('badge-center'); if (bCenter) bCenter.textContent = fmtN(sc.CENTER || 87);
            var bCand = document.getElementById('badge-cand'); if (bCand) bCand.textContent = fmtN(sc.CANDIDATES || 62);
        }

        async function loadCompaniesFromDB() {
            var lblYear = document.getElementById('lbl-year');
            if (lblYear) lblYear.textContent = curYear;

            try {
                var url = '/api/analytics/repeat-segmentation-companies?token=' + encodeURIComponent(TOKEN) + '&year=' + curYear;
                var resp = await fetch(url);
                if (!resp.ok) {
                    throw new Error('HTTP ' + resp.status + ' ' + resp.statusText);
                }
                var json = await resp.json();

                if (json.status === 'ok') {
                    allCompanies = json.data || [];
                    filteredCompanies = allCompanies.slice();

                    // Update KPIs
                    updateKPIs(json.kpi);

                    // Update Buttons
                    updateSubgroupButtons(json.subgroup_counts);

                    // Init Charts
                    initCharts(json);

                    // Render Table
                    applyFilters();
                } else {
                    document.getElementById('companiesTbody').innerHTML = '<tr><td colspan="11" style="text-align:center;padding:30px;color:#dc2626;">⚠️ Помилка завантаження даних</td></tr>';
                }
            } catch (e) {
                console.error('loadCompaniesFromDB error:', e);
                document.getElementById('companiesTbody').innerHTML = '<tr><td colspan="11" style="text-align:center;padding:30px;color:#dc2626;">⚠️ Помилка сервера: ' + e.message + '</td></tr>';
            }
        }

        function selectSubgroup(subKey, btnEl) {
            selectedSubgroup = subKey;
            document.querySelectorAll('.cohort-btn').forEach(function(b) { b.classList.remove('active'); });
            if (btnEl) btnEl.classList.add('active');
            applyFilters();
        }

        function applyFilters() {
            var search = (document.getElementById('searchInput').value || '').toLowerCase().trim();
            var abc = document.getElementById('filterAbc').value;
            var sortBy = document.getElementById('sortBy').value;

            filteredCompanies = allCompanies.filter(function(c) {
                if (selectedSubgroup !== 'ALL' && c.subgroup_key !== selectedSubgroup) return false;
                if (abc !== 'ALL' && c.abc_group !== abc) return false;
                if (search && !c.code.toLowerCase().includes(search) && !c.name.toLowerCase().includes(search)) return false;
                return true;
            });

            // Sorting
            filteredCompanies.sort(function(a, b) {
                if (sortBy === 'rev_desc') return b.goods_revenue - a.goods_revenue;
                if (sortBy === 'rev_asc') return a.goods_revenue - b.goods_revenue;
                if (sortBy === 'days_asc') return a.days_between - b.days_between;
                if (sortBy === 'days_desc') return b.days_between - a.days_between;
                if (sortBy === 'avg_desc') return b.avg_ticket - a.avg_ticket;
                if (sortBy === 'name_asc') return a.name.localeCompare(b.name, 'uk');
                return b.goods_revenue - a.goods_revenue;
            });

            renderTable();
        }

        function renderTable() {
            var tbody = document.getElementById('companiesTbody');
            var counter = document.getElementById('tableCounter');
            if (!tbody) return;

            var totalRevFiltered = filteredCompanies.reduce(function(sum, c) { return sum + (c.goods_revenue || 0); }, 0);
            if (counter) {
                counter.innerHTML = 'Показано <strong>' + fmtN(filteredCompanies.length) + '</strong> з ' + fmtN(allCompanies.length) + ' компаній (Виручка: <strong>' + fmtM(totalRevFiltered) + '</strong>)';
            }

            if (!filteredCompanies.length) {
                tbody.innerHTML = '<tr><td colspan="11" style="text-align:center;padding:30px;color:#94a3b8;">Не знайдено жодної компанії за обраними фільтрами</td></tr>';
                return;
            }

            var rowsHtml = filteredCompanies.map(function(c, idx) {
                var detailUrl = '/client-detail?token=' + encodeURIComponent(TOKEN) + '&code=' + encodeURIComponent(c.code);
                var invs = c.invoices_count || c.inv_count || 0;
                var daysLabel = (c.days_between === 0) ? 'В 1 день' : c.days_between + ' дн.';
                return '<tr>' +
                    '<td class="text-center" style="color:#94a3b8;font-weight:600;">' + (idx + 1) + '</td>' +
                    '<td><a href="' + detailUrl + '" class="client-code-badge">' + c.code + '</a></td>' +
                    '<td><a href="' + detailUrl + '" class="client-row-link">' + c.name + '</a></td>' +
                    '<td>' + getSubgroupBadge(c.subgroup, c.subgroup_key) + '</td>' +
                    '<td class="text-center" style="font-weight:700;">' + fmtN(invs) + '</td>' +
                    '<td class="text-right" style="font-weight:800;color:#0f172a;">' + fmtM(c.goods_revenue) + '</td>' +
                    '<td class="text-right" style="font-weight:600;color:#4f46e5;">' + fmtM(c.avg_ticket) + '</td>' +
                    '<td class="text-center">' + getAbcBadge(c.abc_group) + '</td>' +
                    '<td class="text-center"><span class="badge-days"><i class="fa-regular fa-clock" style="font-size:10px;color:#94a3b8;"></i> ' + daysLabel + '</span></td>' +
                    '<td style="color:#64748b;font-size:12.5px;">' + (c.industry || 'Не вказано') + '</td>' +
                    '<td class="text-center">' +
                        '<button class="action-eye-btn" data-code="' + c.code + '" style="background:#eef2ff;border:1px solid #c7d2fe;color:#4f46e5;padding:4px 8px;border-radius:6px;cursor:pointer;font-size:12px;" title="Швидкий перегляд">' +
                            '<i class="fa-solid fa-eye"></i>' +
                        '</button>' +
                    '</td>' +
                '</tr>';
            }).join('');

            tbody.innerHTML = rowsHtml;
        }

        function initCharts(json) {
            var sc = json.subgroup_counts || {};
            var sr = json.subgroup_revenues || {};

            var labels = ['Швидкий дубль (2)', 'Центр (2-3)', 'Кандидати в постійні (3)'];
            var counts = [sc.QUICK_DOUBLE || 0, sc.CENTER || 0, sc.CANDIDATES || 0];
            var revs = [(sr.QUICK_DOUBLE || 0) / 1e6, (sr.CENTER || 0) / 1e6, (sr.CANDIDATES || 0) / 1e6];

            // Chart 1: Counts Doughnut
            var canvas1 = document.getElementById('chartSubgroupsCount');
            if (canvas1) {
                var ctx1 = canvas1.getContext('2d');
                if (chartSubgroupsCountInstance) chartSubgroupsCountInstance.destroy();
                chartSubgroupsCountInstance = new Chart(ctx1, {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: counts,
                            backgroundColor: ['#f59e0b', '#4f46e5', '#10b981'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'right', labels: { font: { family: 'Inter', size: 11, weight: '600' }, boxWidth: 12 } },
                            tooltip: {
                                callbacks: {
                                    label: function(c) {
                                        return ' ' + c.label + ': ' + c.raw + ' фірм';
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // Chart 2: Revenues Bar
            var canvas2 = document.getElementById('chartSubgroupsRev');
            if (canvas2) {
                var ctx2 = canvas2.getContext('2d');
                if (chartSubgroupsRevInstance) chartSubgroupsRevInstance.destroy();
                chartSubgroupsRevInstance = new Chart(ctx2, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Виручка (млн ₴)',
                            data: revs,
                            backgroundColor: ['rgba(245, 158, 11, 0.85)', 'rgba(79, 70, 229, 0.85)', 'rgba(16, 185, 129, 0.85)'],
                            borderColor: ['#f59e0b', '#4f46e5', '#10b981'],
                            borderWidth: 1,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(c) {
                                        return ' Виручка: ' + c.raw.toFixed(2) + ' млн ₴';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: { grid: { display: false }, ticks: { font: { family: 'Inter', size: 11, weight: '600' } } },
                            y: {
                                grid: { color: 'rgba(226, 232, 240, 0.6)' },
                                ticks: { callback: function(v) { return v + 'M ₴'; }, font: { family: 'Inter', size: 10 } }
                            }
                        }
                    }
                });
            }
        }

        function openCompanyModalByCode(code) {
            var c = allCompanies.find(function(item) { return String(item.code) === String(code); });
            if (!c) return;

            document.getElementById('modalCompName').textContent = c.name;
            document.getElementById('modalCompCode').textContent = c.code;
            document.getElementById('modalRevenue').textContent = fmtM(c.goods_revenue);
            document.getElementById('modalSubgroup').innerHTML = getSubgroupBadge(c.subgroup, c.subgroup_key);
            document.getElementById('modalInvoices').textContent = fmtN(c.invoices_count || c.inv_count || 0);
            document.getElementById('modalAvgTicket').textContent = fmtM(c.avg_ticket);
            document.getElementById('modalDays').textContent = (c.days_between === 0) ? 'В один день' : c.days_between + ' днів';
            document.getElementById('modalAbc').innerHTML = getAbcBadge(c.abc_group);
            document.getElementById('modalIndustry').textContent = c.industry || 'Не вказано';
            document.getElementById('modalStatus').textContent = c.status_name || 'Активний';
            document.getElementById('modalCardLink').href = '/client-detail?token=' + encodeURIComponent(TOKEN) + '&code=' + encodeURIComponent(c.code);

            document.getElementById('companyModal').classList.add('active');
        }

        function closeCompanyModal(e) {
            document.getElementById('companyModal').classList.remove('active');
        }

        function exportToCSV() {
            if (!filteredCompanies.length) {
                alert('Немає даних для експорту');
                return;
            }

            var headers = ['Код 1С', 'Назва компанії', 'Підгрупа', 'Накладних', 'Товарна виручка (грн)', 'Послуги (грн)', 'Середній чек (грн)', 'ABC', 'Дні між покупками', 'Галузь'];
            var csvRows = [headers.join(';')];

            filteredCompanies.forEach(function(c) {
                var invs = c.invoices_count || c.inv_count || 0;
                var row = [
                    '"' + (c.code || '').replace(/"/g, '""') + '"',
                    '"' + (c.name || '').replace(/"/g, '""') + '"',
                    '"' + (c.subgroup || '') + '"',
                    invs,
                    c.goods_revenue,
                    c.services_revenue,
                    c.avg_ticket,
                    '"' + (c.abc_group || '') + '"',
                    c.days_between,
                    '"' + (c.industry || '').replace(/"/g, '""') + '"'
                ];
                csvRows.push(row.join(';'));
            });

            var csvString = '\uFEFF' + csvRows.join('\r\n');
            var blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = 'repeat_segmentation_' + curYear + '.csv';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeCompanyModal();
        });

        document.addEventListener('DOMContentLoaded', function() {
            var tbody = document.getElementById('companiesTbody');
            if (tbody) {
                tbody.addEventListener('click', function(e) {
                    var btn = e.target.closest('.action-eye-btn');
                    if (btn) {
                        var code = btn.getAttribute('data-code');
                        if (code) openCompanyModalByCode(code);
                    }
                });
            }
            loadCompaniesFromDB();
        });
    </script>
</body>
