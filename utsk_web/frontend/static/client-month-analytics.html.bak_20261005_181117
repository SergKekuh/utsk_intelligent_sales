<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📅 UTSK — Анализ месяца компании</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg-main: #f1f5f9;
            --bg-card: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --primary: #4f46e5;
            --primary-light: #e0e7ff;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --radius-lg: 16px;
            --radius-md: 12px;
            --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.05);
            --shadow-md: 0 4px 12px rgba(15, 23, 42, 0.08);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e0f2fe 100%);
            color: var(--text-main);
            min-height: 100vh;
            padding: 24px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .container {
            width: 100%;
            max-width: 1300px;
            margin: 0 auto;
        }

        /* Top Header */
        .top-header {
            background: var(--bg-card);
            padding: 20px 24px;
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #f1f5f9;
            color: var(--text-main);
            text-decoration: none;
            padding: 10px 18px;
            border-radius: var(--radius-md);
            font-weight: 600;
            font-size: 14px;
            border: 1px solid var(--border);
            transition: all 0.2s ease;
        }

        .btn-back:hover {
            background: var(--primary-light);
            color: var(--primary);
            border-color: #c7d2fe;
            transform: translateX(-2px);
        }

        .client-title h1 {
            font-size: 20px;
            font-weight: 800;
            color: var(--text-main);
        }

        .client-meta {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 2px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* KPI Cards Grid */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 24px;
        }

        .kpi-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            padding: 20px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            border-top: 4px solid var(--primary);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .kpi-title {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .kpi-value {
            font-size: 26px;
            font-weight: 800;
            color: var(--text-main);
            margin: 8px 0 4px;
        }

        .kpi-subtext {
            font-size: 12px;
            color: var(--text-muted);
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            margin-bottom: 24px;
        }

        @media (max-width: 1024px) {
            .grid-2 { grid-template-columns: 1fr; }
        }

        .panel-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            padding: 24px;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .panel-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-main);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .chart-container {
            position: relative;
            height: 320px;
            width: 100%;
        }

        /* Tables */
        .table-responsive {
            width: 100%;
            overflow-x: auto;
            border-radius: var(--radius-md);
            border: 1px solid var(--border);
        }

        table.custom-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        table.custom-table th {
            background: #f8fafc;
            color: var(--text-muted);
            font-weight: 700;
            padding: 12px 16px;
            border-bottom: 2px solid var(--border);
            text-align: left;
        }

        table.custom-table td {
            padding: 12px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-main);
        }

        table.custom-table tbody tr:hover {
            background: #f8fafc;
        }

        .btn-view {
            padding: 5px 12px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: #fff;
            color: #4f46e5;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s;
        }

        .btn-view:hover {
            background: #eef2ff;
            border-color: #4f46e5;
        }

        /* Badges */
        .badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }
        .badge-positive { background: #d1fae5; color: #047857; }
        .badge-negative { background: #fee2e2; color: #b91c1c; }
        .badge-neutral { background: #f1f5f9; color: #475569; }
        .badge-status { background: #e0f2fe; color: #0369a1; }

        /* Modal */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(15, 23, 42, 0.4);
            backdrop-filter: blur(4px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }
        .modal-card {
            background: #fff;
            border-radius: var(--radius-lg);
            width: 90%;
            max-width: 750px;
            max-height: 85vh;
            display: flex;
            flex-direction: column;
            box-shadow: var(--shadow-md);
            overflow: hidden;
        }
        .modal-header {
            padding: 18px 24px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .modal-body {
            padding: 20px 24px;
            overflow-y: auto;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Top Header -->
        <header class="top-header">
            <div class="header-left">
                <a href="#" id="btn-back-rev" class="btn-back">← Назад к анализу выручки</a>
                <div class="client-title">
                    <h1 id="month-title">📅 Анализ месяца: —</h1>
                    <div class="client-meta">
                        <span id="client-name-meta">Компания: <strong>—</strong></span>
                        <span>•</span>
                        <span>Код: <strong id="client-code">—</strong></span>
                        <span>•</span>
                        <span class="badge badge-status" id="client-status">—</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- KPI Cards Grid (4 штуки) -->
        <section class="kpi-grid">
            <div class="kpi-card" style="border-top-color: #4f46e5;">
                <span class="kpi-title">💰 Выручка за месяц</span>
                <span class="kpi-value" id="kpi-rev-month" style="color:#4f46e5;">—</span>
                <span class="kpi-subtext">Без сервисных услуг</span>
            </div>
            <div class="kpi-card" style="border-top-color: #06b6d4;">
                <span class="kpi-title">📄 Накладных за месяц</span>
                <span class="kpi-value" id="kpi-inv-month">—</span>
                <span class="kpi-subtext">Количество отгрузок</span>
            </div>
            <div class="kpi-card" style="border-top-color: #a855f7;">
                <span class="kpi-title">🛒 Средний чек</span>
                <span class="kpi-value" id="kpi-avg-check">—</span>
                <span class="kpi-subtext">Выручка / накладные</span>
            </div>
            <div class="kpi-card" style="border-top-color: #10b981;">
                <span class="kpi-title">📈 Рост к прошлому месяцу</span>
                <span class="kpi-value" id="kpi-growth-prev">—</span>
                <span class="kpi-subtext">Динамика MoM</span>
            </div>
        </section>

        <!-- Charts Grid (2 штуки) -->
        <div class="grid-2">
            <div class="panel-card">
                <div class="panel-title">
                    <span>📊 Выручка по дням месяца</span>
                    <span style="font-size:12px;color:var(--text-muted);">Дни 1 - 31</span>
                </div>
                <div class="chart-container">
                    <canvas id="chart-daily-bar"></canvas>
                </div>
            </div>

            <div class="panel-card">
                <div class="panel-title">
                    <span id="chart-compare-title">📊 Сравнение по дням: 2026 vs 2025</span>
                    <span style="font-size:12px;color:var(--text-muted);">Текущий год vs Прошлый год</span>
                </div>
                <div class="chart-container">
                    <canvas id="chart-daily-grouped"></canvas>
                </div>
            </div>
        </div>

        <!-- Tables Grid (3 штуки) -->
        
        <!-- Table 3: Сравнение с прошлым месяцем -->
        <div class="panel-card" style="margin-bottom:24px;">
            <div class="panel-title">📊 Сравнение с прошлым месяцем</div>
            <div class="table-responsive">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Показатель</th>
                            <th style="text-align:right;">Текущий месяц</th>
                            <th style="text-align:right;">Прошлый месяц</th>
                            <th style="text-align:center;">Изменение %</th>
                        </tr>
                    </thead>
                    <tbody id="table-comparison-body">
                        <tr><td colspan="4" style="text-align:center;">⏳ Загрузка...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="grid-2">
            <!-- Table 1: Накладные месяца -->
            <div class="panel-card">
                <div class="panel-title">📄 Накладные месяца</div>
                <div class="table-responsive" style="max-height:420px;overflow-y:auto;">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Дата</th>
                                <th>№ Накладной</th>
                                <th style="text-align:right;">Сумма (₴)</th>
                                <th style="text-align:center;">Позиций</th>
                                <th style="text-align:right;">Детали</th>
                            </tr>
                        </thead>
                        <tbody id="table-invoices-body">
                            <tr><td colspan="5" style="text-align:center;">⏳ Загрузка...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Table 2: ТОП-10 товаров месяца -->
            <div class="panel-card">
                <div class="panel-title">🛍️ ТОП-10 товаров месяца</div>
                <div class="table-responsive" style="max-height:420px;overflow-y:auto;">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Товар</th>
                                <th style="text-align:center;">Накладных</th>
                                <th style="text-align:right;">Сумма (₴)</th>
                                <th style="text-align:right;">Доля %</th>
                            </tr>
                        </thead>
                        <tbody id="table-products-body">
                            <tr><td colspan="5" style="text-align:center;">⏳ Загрузка...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal for Invoice Items -->
    <div class="modal-overlay" id="invoice-modal">
        <div class="modal-card">
            <div class="modal-header">
                <div>
                    <h3 style="font-size:16px;font-weight:800;" id="modal-inv-title">Содержимое накладной № —</h3>
                    <div style="font-size:12px;color:var(--text-muted);" id="modal-inv-date">Дата: —</div>
                </div>
                <button onclick="closeModal()" style="border:none;background:none;font-size:20px;cursor:pointer;color:var(--text-muted);">✕</button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Код</th>
                                <th>Наименование</th>
                                <th style="text-align:right;">Кол-во</th>
                                <th style="text-align:right;">Цена (₴)</th>
                                <th style="text-align:right;">Сумма (₴)</th>
                            </tr>
                        </thead>
                        <tbody id="modal-items-body">
                            <tr><td colspan="5" style="text-align:center;">⏳ Загрузка...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const TOKEN = urlParams.get('token') || 'utsk2026';
        const CLIENT_CODE = urlParams.get('code') || '';
        const YEAR = parseInt(urlParams.get('year') || '2026', 10);
        const MONTH = parseInt(urlParams.get('month') || '1', 10);

        let chartInstances = {};

        function fmtNum(n) { return (n == null) ? '—' : Number(n).toLocaleString('ru-RU'); }
        function fmtCur(n) { return (n == null) ? '—' : '₴ ' + fmtNum(Math.round(n)); }
        function fmtPct(n) { return (n == null) ? '—' : (n > 0 ? '+' : '') + n.toFixed(1) + '%'; }

        document.addEventListener('DOMContentLoaded', () => {
            const btnBack = document.getElementById('btn-back-rev');
            if (btnBack) btnBack.href = `/client-revenue-analytics?token=${TOKEN}&code=${CLIENT_CODE}&year=${YEAR}`;
            loadAllData();
        });

        async function loadAllData() {
            await Promise.all([
                loadSummary(),
                loadDaily(),
                loadInvoices(),
                loadProducts()
            ]);
        }

        async function loadSummary() {
            try {
                const res = await fetch(`/api/analytics/client/month-summary?token=${TOKEN}&code=${CLIENT_CODE}&year=${YEAR}&month=${MONTH}`);
                const data = await res.json();
                if (data.status !== 'ok') return;

                const info = data.client_info;
                const mInfo = data.month_info;
                const kpi = data.kpi;
                const prevM = data.prev_month_comparison;

                document.getElementById('month-title').textContent = `📅 Анализ месяца: ${mInfo.month_name} ${mInfo.year} г.`;
                document.getElementById('chart-compare-title').textContent = `📊 Сравнение по дням: ${mInfo.month_name} ${mInfo.year} vs ${mInfo.year - 1}`;
                document.getElementById('client-name-meta').innerHTML = `Компания: <strong>${info.name}</strong>`;
                document.getElementById('client-code').textContent = info.code;
                document.getElementById('client-status').textContent = info.status_name;

                // KPI Cards
                document.getElementById('kpi-rev-month').textContent = fmtCur(kpi.rev_month);
                document.getElementById('kpi-inv-month').textContent = `${kpi.inv_month} шт.`;
                document.getElementById('kpi-avg-check').textContent = fmtCur(kpi.avg_check_month);

                const growthElem = document.getElementById('kpi-growth-prev');
                if (kpi.growth_to_prev_month_pct !== null && kpi.growth_to_prev_month_pct !== undefined) {
                    growthElem.textContent = fmtPct(kpi.growth_to_prev_month_pct);
                    growthElem.style.color = kpi.growth_to_prev_month_pct >= 0 ? '#10b981' : '#ef4444';
                } else {
                    growthElem.textContent = '—';
                    growthElem.style.color = '#64748b';
                }

                // Table 3: Comparison with previous month
                const compBody = document.getElementById('table-comparison-body');
                compBody.innerHTML = '';

                const metrics = [
                    { name: 'Выручка', curr: fmtCur(prevM.rev_curr), prev: fmtCur(prevM.rev_prev_month), pct: prevM.rev_change_pct },
                    { name: 'Количество накладных', curr: `${prevM.inv_curr} шт.`, prev: `${prevM.inv_prev_month} шт.`, pct: prevM.inv_change_pct },
                    { name: 'Средний чек', curr: fmtCur(prevM.avg_curr), prev: fmtCur(prevM.avg_prev_month), pct: prevM.avg_change_pct }
                ];

                metrics.forEach(m => {
                    const pctStr = m.pct !== null ? fmtPct(m.pct) : '—';
                    const pctClass = m.pct >= 0 ? 'badge-positive' : (m.pct < 0 ? 'badge-negative' : 'badge-neutral');

                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td style="font-weight:700;">${m.name}</td>
                        <td style="text-align:right;font-weight:700;color:#4f46e5;">${m.curr}</td>
                        <td style="text-align:right;color:var(--text-muted);">${m.prev}</td>
                        <td style="text-align:center;"><span class="badge ${pctClass}">${pctStr}</span></td>
                    `;
                    compBody.appendChild(tr);
                });

            } catch (err) {
                console.error('Error loading month summary:', err);
            }
        }

        async function loadDaily() {
            try {
                const res = await fetch(`/api/analytics/client/month-daily?token=${TOKEN}&code=${CLIENT_CODE}&year=${YEAR}&month=${MONTH}`);
                const data = await res.json();
                if (data.status !== 'ok') return;

                const daily = data.daily || [];
                const daysLabels = daily.map(d => `День ${d.day}`);
                const revCurrs = daily.map(d => d.rev_curr);
                const revPrevs = daily.map(d => d.rev_prev_year);

                // Chart 1: Bar Chart Daily Current Year
                renderChart('chart-daily-bar', 'bar', {
                    labels: daysLabels,
                    datasets: [
                        { label: `Выручка ${YEAR} (₴)`, data: revCurrs, backgroundColor: '#4f46e5', borderRadius: 4 }
                    ]
                });

                // Chart 2: Grouped Bar Chart Comparison
                renderChart('chart-daily-grouped', 'bar', {
                    labels: daysLabels,
                    datasets: [
                        { label: `${YEAR} (₴)`, data: revCurrs, backgroundColor: '#4f46e5', borderRadius: 4 },
                        { label: `${YEAR - 1} (₴)`, data: revPrevs, backgroundColor: '#94a3b8', borderRadius: 4 }
                    ]
                });

            } catch (err) {
                console.error('Error loading daily analytics:', err);
            }
        }

        async function loadInvoices() {
            try {
                const res = await fetch(`/api/analytics/client/month-invoices?token=${TOKEN}&code=${CLIENT_CODE}&year=${YEAR}&month=${MONTH}`);
                const data = await res.json();
                if (data.status !== 'ok') return;

                const tbody = document.getElementById('table-invoices-body');
                tbody.innerHTML = '';
                const invoices = data.invoices || [];

                if (!invoices.length) {
                    tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">Нет накладных за этот месяц</td></tr>';
                    return;
                }

                invoices.forEach(inv => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>${inv.doc_date}</td>
                        <td style="font-weight:700;">${inv.doc_number}</td>
                        <td style="text-align:right;font-weight:700;color:#4f46e5;">₴ ${fmtNum(inv.amount)}</td>
                        <td style="text-align:center;font-weight:700;">${inv.items_count}</td>
                        <td style="text-align:right;">
                            <button class="btn-view" onclick="openInvoiceDetails(${inv.doc_id}, '${inv.doc_number}', '${inv.doc_date}')">🔍 Позиции (${inv.items_count})</button>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            } catch (err) {
                console.error('Error loading month invoices:', err);
            }
        }

        async function loadProducts() {
            try {
                const res = await fetch(`/api/analytics/client/month-products?token=${TOKEN}&code=${CLIENT_CODE}&year=${YEAR}&month=${MONTH}`);
                const data = await res.json();
                if (data.status !== 'ok') return;

                const tbody = document.getElementById('table-products-body');
                tbody.innerHTML = '';
                const products = data.products || [];

                if (!products.length) {
                    tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">Нет отгруженных товаров в этом месяце</td></tr>';
                    return;
                }

                products.forEach(p => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td style="font-weight:700;">${p.rank}</td>
                        <td style="font-weight:600;" title="Код: ${p.product_code}">${p.product_name}</td>
                        <td style="text-align:center;">${p.invoices_count}</td>
                        <td style="text-align:right;font-weight:700;color:#4f46e5;">₴ ${fmtNum(p.total_amount)}</td>
                        <td style="text-align:right;font-weight:700;color:#047857;">${p.share_pct}%</td>
                    `;
                    tbody.appendChild(tr);
                });
            } catch (err) {
                console.error('Error loading month products:', err);
            }
        }

        async function openInvoiceDetails(docId, docNumber, docDate) {
            document.getElementById('modal-inv-title').textContent = `Содержимое накладной № ${docNumber}`;
            document.getElementById('modal-inv-date').textContent = `Дата выписки: ${docDate}`;
            const tbody = document.getElementById('modal-items-body');
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">⏳ Загрузка позиций...</td></tr>';
            document.getElementById('invoice-modal').style.display = 'flex';

            try {
                const res = await fetch(`/api/client/${CLIENT_CODE}/invoice/${docId}?token=${TOKEN}`);
                const data = await res.json();
                tbody.innerHTML = '';

                const items = data.items || [];
                if (!items.length) {
                    tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">Нет данных по позициям</td></tr>';
                    return;
                }

                items.forEach(p => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td><code>${p.product_code || p.code || '—'}</code></td>
                        <td style="font-weight:600;">${p.product_name || p.name || '—'}</td>
                        <td style="text-align:right;">${p.quantity}</td>
                        <td style="text-align:right;">₴ ${fmtNum(p.price)}</td>
                        <td style="text-align:right;font-weight:700;color:#4f46e5;">₴ ${fmtNum(p.amount)}</td>
                    `;
                    tbody.appendChild(tr);
                });
            } catch (err) {
                console.error('Error loading invoice details:', err);
                tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:red;">Ошибка загрузки позиций</td></tr>';
            }
        }

        function closeModal() {
            document.getElementById('invoice-modal').style.display = 'none';
        }

        function renderChart(canvasId, type, configData) {
            if (chartInstances[canvasId]) chartInstances[canvasId].destroy();
            const ctx = document.getElementById(canvasId).getContext('2d');
            chartInstances[canvasId] = new Chart(ctx, {
                type: type,
                data: configData,
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#475569', font: { family: 'Inter', size: 12, weight: 600 } } } },
                    scales: {
                        x: { grid: { color: '#e2e8f0' }, ticks: { color: '#64748b', font: { family: 'Inter', size: 11 } } },
                        y: { grid: { color: '#e2e8f0' }, ticks: { color: '#64748b', font: { family: 'Inter', size: 11 } } }
                    }
                }
            });
        }
    </script>
</body>
</html>
