        function renderMonthlyTable(rows) {
            const tbody = document.getElementById('monthlyTableBody');
            if (!tbody) return;
            tbody.innerHTML = '';

            rows.forEach(r => {
                const delta = Number(r.delta_abs) || 0;
                const pct = r.delta_pct;
                const color = delta > 0 ? '#047857' : (delta < 0 ? '#dc2626' : '#64748b');
                const arrow = delta > 0 ? '↑' : (delta < 0 ? '↓' : '→');
                const pctStr = (pct === null || pct === undefined) ? '—' : (Number(pct).toFixed(1) + '%');

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><strong>${r.month_name}</strong></td>
                    <td style="text-align:right; font-family:'JetBrains Mono';">${fmtFullMoney(r.revenue_cur)}</td>
                    <td style="text-align:right; font-family:'JetBrains Mono'; color:#64748b;">${r.revenue_prev > 0 ? fmtFullMoney(r.revenue_prev) : '—'}</td>
                    <td style="text-align:right; font-family:'JetBrains Mono'; color:${color};">${delta !== 0 ? arrow + ' ' + fmtFullMoney(Math.abs(delta)) : '—'}</td>
                    <td style="text-align:right; font-family:'JetBrains Mono'; color:${color};">${pctStr}</td>
                    <td style="text-align:right; font-family:'JetBrains Mono';">${r.invoices_cur}</td>
                    <td style="text-align:right; font-family:'JetBrains Mono';">${r.avg_check > 0 ? fmtFullMoney(r.avg_check) : '—'}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function renderMonthlyInsights(rows, kpi) {
            const ul = document.getElementById('monthlyInsights');
            if (!ul) return;
            const insights = [];

            if (kpi.best_month_name) {
                insights.push(`🏆 <strong>Найкращий місяць:</strong> ${kpi.best_month_name} (${fmtMoney(kpi.best_month_revenue)})`);
            }
            if (kpi.worst_month_name && kpi.worst_month_name !== kpi.best_month_name) {
                insights.push(`📉 <strong>Найгірший місяць:</strong> ${kpi.worst_month_name} (${fmtMoney(kpi.worst_month_revenue)})`);
            }
            if (kpi.active_months) {
                insights.push(`📅 <strong>Активність:</strong> продажі у ${kpi.active_months} з 12 місяців`);
            }

            // Кварталы
            const q = [0, 0, 0, 0];
            rows.forEach(r => {
                const qIdx = Math.floor((r.month_num - 1) / 3);
                q[qIdx] += Number(r.revenue_cur) || 0;
            });
            const maxQ = Math.max(...q);
            if (maxQ > 0) {
                const bestQ = q.indexOf(maxQ) + 1;
                insights.push(`📊 <strong>Найсильніший квартал:</strong> Q${bestQ} (${fmtMoney(maxQ)})`);
            }

            if (kpi.avg_check) {
                insights.push(`💵 <strong>Середній чек:</strong> ${fmtFullMoney(kpi.avg_check)}`);
            }

            ul.innerHTML = insights.map(i => `<li>${i}</li>`).join('') || '<li>Немає даних</li>';
        }

        // ---- INIT ----
        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('year-select').value = YEAR;
            document.getElementById('clientCode').textContent = CLIENT_CODE;
            document.getElementById('backBtn').href = `/client-detail?token=${encodeURIComponent(TOKEN)}&code=${encodeURIComponent(CLIENT_CODE)}`;

            loadKPI();
            loadSizes();
        });
    </script>
</body>
</html>