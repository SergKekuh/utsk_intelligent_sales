        async function loadMonthly() {
            try {
                const [resData, resKpi] = await Promise.all([
                    fetch(`/api/analytics/profile-pipes/monthly-v2?token=${encodeURIComponent(TOKEN)}&code=${encodeURIComponent(CLIENT_CODE)}&year=${YEAR}`),
                    fetch(`/api/analytics/profile-pipes/monthly-kpi?token=${encodeURIComponent(TOKEN)}&code=${encodeURIComponent(CLIENT_CODE)}&year=${YEAR}`),
                ]);
                if (!resData.ok) throw new Error(`HTTP ${resData.status}`);
                const jsonData = await resData.json();
                const rows = jsonData.data || [];

                let kpi = {};
                if (resKpi.ok) {
                    const jsonKpi = await resKpi.json();
                    kpi = jsonKpi.data || {};
                }

                renderMonthlyKPI(kpi);
                renderMonthlyChart(rows);
                renderMonthlyTable(rows);
                renderMonthlyInsights(rows, kpi);
            } catch (e) {
                console.error('[MONTHLY] error:', e);
            }
        }

        function renderMonthlyKPI(kpi) {
            const set = (id, val) => {
                const el = document.getElementById(id);
                if (el) el.textContent = val;
            };
            set('mKpiRevenue', fmtMoney(kpi.total_revenue || 0));
            set('mKpiAvg', fmtMoney(kpi.avg_monthly || 0));
            set('mKpiBest', kpi.best_month_name || '—');
            set('mKpiBestMonth', kpi.best_month_revenue ? fmtMoney(kpi.best_month_revenue) : '');
            set('mKpiActive', (kpi.active_months || 0) + ' / 12');
        }

        function renderMonthlyChart(rows) {
            const canvas = document.getElementById('chartMonthly');
            if (!canvas) return;
            if (charts.monthly) charts.monthly.destroy();

            charts.monthly = new Chart(canvas, {
                data: {
                    labels: rows.map(r => r.month_name),
                    datasets: [
                        {
                            type: 'bar',
                            label: '2025',
                            data: rows.map(r => Number(r.revenue_prev) || 0),
                            backgroundColor: '#cbd5e1',
                            borderRadius: 6,
                            yAxisID: 'y',
                            order: 2
                        },
                        {
                            type: 'bar',
                            label: '2026',
                            data: rows.map(r => Number(r.revenue_cur) || 0),
                            backgroundColor: '#4f46e5',
                            borderRadius: 6,
                            yAxisID: 'y',
                            order: 1
                        },
                        {
                            type: 'line',
                            label: 'Накладні (шт)',
                            data: rows.map(r => Number(r.invoices_cur) || 0),
                            borderColor: '#f59e0b',
                            backgroundColor: 'transparent',
                            borderWidth: 2,
                            tension: 0.3,
                            pointRadius: 4,
                            pointBackgroundColor: '#f59e0b',
                            yAxisID: 'y1',
                            order: 0
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    scales: {
                        y: {
                            beginAtZero: true,
                            position: 'left',
