                console.error('[SIZES] error:', e);
                tbody.innerHTML = `<tr><td colspan="6" class="loading" style="color:var(--danger);"><i class="fa-solid fa-triangle-exclamation"></i> Помилка завантаження: ${e.message}</td></tr>`;
