        // ---- SIZES (Tab 1) ----
        async function loadSizes() {
            const tbody = document.getElementById('sizesBody');
            if (!tbody) return;
            tbody.innerHTML = '<tr><td colspan="6" class="loading"><i class="fa-solid fa-spinner fa-spin"></i> Завантаження розмірів труб...</td></tr>';
            closeDrilldown();

            try {
                const r = await fetch(`/api/analytics/profile-pipes/sizes?token=${encodeURIComponent(TOKEN)}&code=${encodeURIComponent(CLIENT_CODE)}&year=${YEAR}`);
                if (!r.ok) throw new Error(`HTTP ${r.status}`);
                const json = await r.json();

                if (json.client_name && document.getElementById('clientName').textContent === 'Загрузка...') {
                    document.getElementById('clientName').textContent = json.client_name;
                }

                allSizes = json.data || [];
                if (document.getElementById('totalSizesBadge')) {
                    document.getElementById('totalSizesBadge').textContent = allSizes.length;
