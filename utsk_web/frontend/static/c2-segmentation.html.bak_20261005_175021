<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UTSK — 💡 Лайт (Дрібні клієнти)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg-app: #f8fafc;
            --bg-surface: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --primary: #d97706;
            --primary-light: #fef3c7;
            --radius-lg: 16px;
            --radius-md: 10px;
            --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.05);
            --shadow-md: 0 4px 12px rgba(15, 23, 42, 0.06);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-app);
            color: var(--text-main);
            line-height: 1.5;
            padding: 24px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* Top Header */
        .top-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--bg-surface);
            padding: 20px 24px;
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .header-title-area {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #f1f5f9;
            color: var(--text-main);
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 13.5px;
            transition: all 0.2s ease;
            border: 1px solid var(--border);
            cursor: pointer;
        }

        .btn-action:hover {
            background: #e2e8f0;
            transform: translateY(-1px);
        }

        .btn-primary {
            background: #d97706;
            color: #ffffff;
            border-color: #b45309;
        }

        .btn-primary:hover {
            background: #b45309;
            color: #ffffff;
        }

        .header-info h1 {
            font-size: 22px;
            font-weight: 800;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .header-info .meta {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 3px;
            font-weight: 500;
        }

        .meta-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: #fef3c7;
            padding: 2px 8px;
            border-radius: 6px;
            font-weight: 600;
            color: #92400e;
        }

        /* 6 KPI Grid */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 14px;
            margin-bottom: 24px;
        }

        .kpi-card {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 16px;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

        .kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .kpi-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
        }

        .kpi-lbl {
            font-size: 11px;
            text-transform: uppercase;
            font-weight: 700;
            color: var(--text-muted);
            letter-spacing: 0.3px;
        }

        .kpi-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        .kpi-val {
            font-size: 20px;
            font-weight: 900;
            color: var(--text-main);
        }

        .kpi-sub {
            font-size: 11.5px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        /* Filter Tabs Card */
        .cohort-nav-card {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 16px 20px;
            box-shadow: var(--shadow-sm);
            margin-bottom: 24px;
        }

        .cohort-nav-title {
            font-size: 13px;
            font-weight: 800;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .cohort-buttons-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .cohort-btn {
            background: #f8fafc;
            border: 1px solid var(--border);
            padding: 9px 18px;
            border-radius: 10px;
            font-family: inherit;
            font-size: 13.5px;
            font-weight: 700;
            color: #334155;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.15s ease;
        }

        .cohort-btn:hover {
            background: #fef3c7;
            border-color: #fde68a;
            color: #92400e;
        }

        .cohort-btn.active {
            background: #d97706;
            color: #ffffff;
            border-color: #b45309;
            box-shadow: 0 2px 6px rgba(217, 119, 6, 0.25);
        }

        .cohort-badge {
            background: rgba(0, 0, 0, 0.08);
            padding: 2px 7px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 800;
        }

        .cohort-btn.active .cohort-badge {
            background: rgba(255, 255, 255, 0.25);
            color: #ffffff;
        }

        /* 2 Charts Grid */
        .charts-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        .bento-card {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 20px;
            box-shadow: var(--shadow-sm);
        }

        .bento-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 1px solid #f1f5f9;
        }

        .bento-card-title {
            font-size: 15.5px;
            font-weight: 800;
            color: #1e293b;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .bento-card-subtitle {
            font-size: 12.5px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        /* Filter Controls Bar */
        .filters-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

        .filters-left {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .search-box {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #f8fafc;
            border: 1px solid var(--border);
            padding: 8px 14px;
            border-radius: 10px;
            width: 280px;
        }

        .search-box input {
            border: none;
            background: transparent;
            font-family: inherit;
            font-size: 13.5px;
            color: var(--text-main);
            width: 100%;
            outline: none;
        }

        .select-filter {
            background: #f8fafc;
            border: 1px solid var(--border);
            padding: 8px 12px;
            border-radius: 10px;
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-main);
            outline: none;
            cursor: pointer;
        }

        .table-counter-box {
            font-size: 13px;
            font-weight: 700;
            color: var(--text-muted);
        }

        /* Table */
        .detail-table-wrap {
            overflow-x: auto;
            border: 1px solid var(--border);
            border-radius: 12px;
        }

        .detail-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            font-family: inherit;
            text-align: left;
        }

        .detail-table th {
            background: #f1f5f9;
            color: #334155;
            font-weight: 700;
            padding: 12px 14px;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        .detail-table td {
            padding: 11px 14px;
            border-bottom: 1px solid #f1f5f9;
            color: var(--text-main);
            vertical-align: middle;
        }

        .detail-table tr:hover td {
            background: #f8fafc;
        }

        .client-code-badge {
            display: inline-block;
            background: #fef3c7;
            color: #92400e;
            padding: 2px 7px;
            border-radius: 6px;
            font-weight: 700;
            font-size: 12px;
            text-decoration: none;
            border: 1px solid #fde68a;
        }

        .client-row-link {
            text-decoration: none;
            color: #0f172a;
            font-weight: 600;
            transition: color 0.15s ease;
        }

        .client-row-link:hover {
            color: #d97706;
            text-decoration: underline;
        }

        /* Badges */
        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .badge-c2 { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }

        .badge-cohort {
            background: #f1f5f9;
            color: #334155;
        }

        .text-right { text-align: right !important; }
        .text-center { text-align: center !important; }

        /* Quick View Modal */
        .modal-backdrop {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(4px);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .modal-backdrop.active { display: flex; }

        .modal-card {
            background: #ffffff;
            border-radius: 16px;
            max-width: 580px;
            width: 100%;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
            border: 1px solid #e2e8f0;
            overflow: hidden;
            animation: modalFadeIn 0.2s ease-out;
        }
        @keyframes modalFadeIn {
            from { opacity: 0; transform: translateY(12px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .modal-header {
            padding: 18px 24px;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f8fafc;
        }

        .modal-title {
            font-size: 17px;
            font-weight: 800;
            color: #0f172a;
        }

        .modal-close {
            background: none;
            border: none;
            font-size: 24px;
            color: #94a3b8;
            cursor: pointer;
            line-height: 1;
        }

        .modal-close:hover { color: #0f172a; }

        .modal-body { padding: 24px; }

        .modal-stat-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 16px;
        }

        .modal-stat-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 12px 14px;
        }

        .modal-stat-box.highlight {
            grid-column: 1 / -1;
            background: #fffbeb;
            border-color: #fde68a;
        }

        .modal-stat-lbl {
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
        }

        .modal-stat-val {
            font-size: 18px;
            font-weight: 800;
            color: #0f172a;
            margin-top: 4px;
        }

        .modal-footer {
            padding: 14px 24px;
            border-top: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f8fafc;
        }

        @media (max-width: 1200px) {
            .kpi-grid { grid-template-columns: repeat(3, 1fr); }
            .charts-grid { grid-template-columns: 1fr; }
        }

        @media (max-width: 768px) {
            body { padding: 12px; }
            .kpi-grid { grid-template-columns: 1fr 1fr; }
            .top-header { flex-direction: column; align-items: flex-start; }
            .search-box { width: 100%; }
        }
    </style>
</head>
<body>

    <div class="container">

        <!-- Top Header -->
        <div class="top-header">
            <div class="header-title-area">
                <button class="btn-action" onclick="goBack()">
                    <i class="fa-solid fa-arrow-left"></i> До матриці
                </button>
                <div class="header-info">
                    <h1><i class="fa-solid fa-lightbulb" style="color:#d97706;"></i> 💡 Лайт — Дрібні клієнти (<span id="title-count">352</span> компанії)</h1>
                    <div class="meta">
                        Рік: <span class="meta-pill" id="lbl-year">2026</span> &nbsp;|&nbsp; 
                        Критерій: <span class="meta-pill">Тоннаж ≤ 2 т/рік або Виручка ≤ 146 000 ₴</span> &nbsp;|&nbsp; 
                        БД: <span class="meta-pill">PostgreSQL (bd_intelligent_sales)</span>
                    </div>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
                <button class="btn-action btn-primary" onclick="exportToCSV()">
                    <i class="fa-solid fa-file-csv"></i> Експорт у CSV
                </button>
            </div>
        </div>

        <!-- 6 KPI Cards -->
        <div class="kpi-grid">
            <!-- 1. Всього Лайт -->
            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-lbl">Всього Лайт</span>
                    <div class="kpi-icon" style="background:#fef3c7;color:#b45309;"><i class="fa-solid fa-users"></i></div>
                </div>
                <div class="kpi-val" id="kpi-total-c2" style="color:#b45309;">352</div>
                <div class="kpi-sub">Клієнти мікро-сегменту</div>
            </div>

            <!-- 2. Виручка Лайт -->
            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-lbl">Виручка Лайт</span>
                    <div class="kpi-icon" style="background:#ecfdf5;color:#10b981;"><i class="fa-solid fa-sack-dollar"></i></div>
                </div>
                <div class="kpi-val" id="kpi-revenue">—</div>
                <div class="kpi-sub">Товарний обсяг продажів</div>
            </div>

            <!-- 3. Накладних -->
            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-lbl">Накладних</span>
                    <div class="kpi-icon" style="background:#eff6ff;color:#2563eb;"><i class="fa-solid fa-file-invoice"></i></div>
                </div>
                <div class="kpi-val" id="kpi-invoices">—</div>
                <div class="kpi-sub">Оформлено документів</div>
            </div>

            <!-- 4. Сер. чек -->
            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-lbl">Сер. чек</span>
                    <div class="kpi-icon" style="background:#fffbeb;color:#d97706;"><i class="fa-solid fa-receipt"></i></div>
                </div>
                <div class="kpi-val" id="kpi-avg-check">—</div>
                <div class="kpi-sub">Виручка / Накладні</div>
            </div>

            <!-- 5. % від загальної бази -->
            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-lbl">% від бази</span>
                    <div class="kpi-icon" style="background:#fdf4ff;color:#a855f7;"><i class="fa-solid fa-pie-chart"></i></div>
                </div>
                <div class="kpi-val" id="kpi-share">48.3%</div>
                <div class="kpi-sub">Частка серед 729 фірм</div>
            </div>

            <!-- 6. Потенціал росту -->
            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-lbl">Потенціал росту</span>
                    <div class="kpi-icon" style="background:#fef2f2;color:#ef4444;"><i class="fa-solid fa-arrow-trend-up"></i></div>
                </div>
                <div class="kpi-val" id="kpi-potential" style="color:#b91c1c;">—</div>
                <div class="kpi-sub">Резерв до планки B2</div>
            </div>
        </div>

        <!-- Filter Mode Switches -->
        <div class="cohort-nav-card">
            <div class="cohort-nav-title">
                <i class="fa-solid fa-filter"></i> Критерій відбору клієнтів сегмента Лайт
            </div>
            <div class="cohort-buttons-wrap">
                <button class="cohort-btn active" onclick="setFilterMode('all', this)">
                    📊 Всі Лайт (≤ 2 т/рік або ≤ 146 000 ₴) <span class="cohort-badge" id="badge-all">352</span>
                </button>
                <button class="cohort-btn" onclick="setFilterMode('revenue', this)">
                    💰 Тільки за виручкою (≤ 146 000 ₴) <span class="cohort-badge" id="badge-rev">352</span>
                </button>
                <button class="cohort-btn" onclick="setFilterMode('tonnage', this)">
                    ⚖️ Тільки за тоннажем (≤ 2 т/рік) <span class="cohort-badge" id="badge-ton">352</span>
                </button>
            </div>
        </div>

        <!-- 2 Charts Grid -->
        <div class="charts-grid">
            <!-- Chart 1: Розподіл C2 по частоті -->
            <div class="bento-card">
                <div class="bento-card-header">
                    <div>
                        <h2 class="bento-card-title">
                            <i class="fa-solid fa-chart-column" style="color:#d97706;"></i> Розподіл Лайт за частотними когортами
                        </h2>
                        <div class="bento-card-subtitle">Кількість клієнтів у розрізі інтенсивності замовлень</div>
                    </div>
                </div>
                <div style="height: 260px; width: 100%; position: relative;">
                    <canvas id="chartC2Frequency"></canvas>
                </div>
            </div>

            <!-- Chart 2: ТОП-10 товарів C2 -->
            <div class="bento-card">
                <div class="bento-card-header">
                    <div>
                        <h2 class="bento-card-title">
                            <i class="fa-solid fa-ranking-star" style="color:#2563eb;"></i> ТОП-10 товарів серед клієнтів Лайт
                        </h2>
                        <div class="bento-card-subtitle">Найпопулярніші товарні позиції за виручкою (тис. ₴)</div>
                    </div>
                </div>
                <div style="height: 260px; width: 100%; position: relative;">
                    <canvas id="chartC2TopProducts"></canvas>
                </div>
            </div>
        </div>

        <!-- Companies Table Bento Card -->
        <div class="bento-card">
            <div class="bento-card-header">
                <div>
                    <h2 class="bento-card-title">
                        <i class="fa-solid fa-list-check" style="color:#0f172a;"></i> Реєстр клієнтів категорії Лайт
                    </h2>
                    <div class="bento-card-subtitle">Клікніть на компанію для переходу в картку або 👁️ для швидкої інформації</div>
                </div>
            </div>

            <!-- Filters Bar -->
            <div class="filters-bar">
                <div class="filters-left">
                    <div class="search-box">
                        <i class="fa-solid fa-magnifying-glass" style="color:#94a3b8;"></i>
                        <input type="text" id="searchInput" placeholder="Пошук за кодом або назвою..." oninput="applyFilters()">
                    </div>

                    <select id="filterCohort" class="select-filter" onchange="applyFilters()">
                        <option value="ALL">Всі когорти</option>
                        <option value="Разові (1)">Разові (1)</option>
                        <option value="Повторні (2-3)">Повторні (2-3)</option>
                        <option value="Квартальні (4-10)">Квартальні (4-10)</option>
                        <option value="Місячні (11-40)">Місячні (11-40)</option>
                        <option value="Тижневі (41-170)">Тижневі (41-170)</option>
                        <option value="Щоденні (>170)">Щоденні (&gt;170)</option>
                    </select>

                    <select id="sortBy" class="select-filter" onchange="applyFilters()">
                        <option value="rev_desc">Сортування: Виручка (макс)</option>
                        <option value="rev_asc">Сортування: Виручка (мін)</option>
                        <option value="ton_desc">Сортування: Тоннаж (макс)</option>
                        <option value="ton_asc">Сортування: Тоннаж (мін)</option>
                        <option value="inv_desc">Сортування: Накладні (макс)</option>
                        <option value="avg_desc">Сортування: Сер. чек (макс)</option>
                        <option value="name_asc">Сортування: Назва (А-Я)</option>
                    </select>
                </div>

                <div class="table-counter-box" id="tableCounter">
                    Показано 352 компанії
                </div>
            </div>

            <!-- Table -->
            <div class="detail-table-wrap">
                <table class="detail-table">
                    <thead>
                        <tr>
                            <th style="width: 40px;" class="text-center">#</th>
                            <th style="width: 90px;">Код 1С</th>
                            <th>Назва компанії</th>
                            <th class="text-center" style="width: 140px;">Когорта</th>
                            <th class="text-center" style="width: 90px;">Накладних</th>
                            <th class="text-right" style="width: 130px;">Виручка (₴)</th>
                            <th class="text-right" style="width: 110px;">Тоннаж (т)</th>
                            <th class="text-right" style="width: 120px;">Сер. чек (₴)</th>
                            <th class="text-center" style="width: 95px;">Клас</th>
                            <th>Галузь</th>
                            <th class="text-center" style="width: 80px;">Дія</th>
                        </tr>
                    </thead>
                    <tbody id="companiesTbody">
                        <tr>
                            <td colspan="11" style="text-align:center;padding:30px;color:#94a3b8;">
                                ⏳ Завантаження бази C2 клієнтів з PostgreSQL...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- Quick View Modal -->
    <div id="companyModal" class="modal-backdrop" onclick="closeCompanyModal(event)">
        <div class="modal-card" onclick="event.stopPropagation()">
            <div class="modal-header">
                <div>
                    <h3 class="modal-title" id="modalCompName">Назва компанії</h3>
                    <div style="font-size:12px;color:#64748b;margin-top:2px;">Код 1С: <strong id="modalCompCode">—</strong></div>
                </div>
                <button class="modal-close" onclick="closeCompanyModal()">&times;</button>
            </div>
            <div class="modal-body">
                <div class="modal-stat-grid">
                    <div class="modal-stat-box highlight">
                        <div class="modal-stat-lbl">Товарна виручка</div>
                        <div class="modal-stat-val" id="modalRevenue" style="color:#b45309;">—</div>
                    </div>
                    <div class="modal-stat-box">
                        <div class="modal-stat-lbl">Загальний тоннаж</div>
                        <div class="modal-stat-val" id="modalTonnage" style="font-size:16px;">—</div>
                    </div>
                    <div class="modal-stat-box">
                        <div class="modal-stat-lbl">Когорта</div>
                        <div class="modal-stat-val" id="modalCohort" style="font-size:14px;">—</div>
                    </div>
                    <div class="modal-stat-box">
                        <div class="modal-stat-lbl">Кількість накладних</div>
                        <div class="modal-stat-val" id="modalInvoices">—</div>
                    </div>
                    <div class="modal-stat-box">
                        <div class="modal-stat-lbl">Середній чек</div>
                        <div class="modal-stat-val" id="modalAvgTicket">—</div>
                    </div>
                    <div class="modal-stat-box">
                        <div class="modal-stat-lbl">Клас</div>
                        <div class="modal-stat-val" id="modalAbc"><span class="badge badge-c2">💡 Лайт</span></div>
                    </div>
                    <div class="modal-stat-box">
                        <div class="modal-stat-lbl">Галузь діяльності</div>
                        <div class="modal-stat-val" id="modalIndustry" style="font-size:14px;">—</div>
                    </div>
                    <div class="modal-stat-box">
                        <div class="modal-stat-lbl">Статус клієнта</div>
                        <div class="modal-stat-val" id="modalStatus" style="font-size:14px;">—</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-action" onclick="closeCompanyModal()">Закрити</button>
                <a id="modalCardLink" href="#" class="btn-action btn-primary">
                    Перейти до повної картки клієнта <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <script>
        var TOKEN = new URLSearchParams(window.location.search).get('token') || 'utsk2026';
        var curYear = parseInt(new URLSearchParams(window.location.search).get('year')) || 2026;
        var curFilterMode = 'all';

        var allCompanies = [];
        var filteredCompanies = [];
        var topProducts = [];
        var chartC2FreqInstance = null;
        var chartC2TopProdInstance = null;

        function fmtN(n) {
            if (n === null || n === undefined || isNaN(n)) return '0';
            return Number(n).toLocaleString('ru-RU');
        }

        function fmtM(n) {
            if (n === null || n === undefined || isNaN(n)) return '0 ₴';
            return Number(n).toLocaleString('ru-RU', { maximumFractionDigits: 0 }) + ' ₴';
        }

        function goBack() {
            var url = '/analytics?token=' + encodeURIComponent(TOKEN);
            window.location.href = url;
        }

        function updateKPIs(kpiData) {
            var totalRevenue = (kpiData && kpiData.total_revenue !== undefined)
                ? kpiData.total_revenue
                : allCompanies.reduce(function(sum, c) { return sum + (c.goods_revenue || 0); }, 0);

            var totalInvoices = (kpiData && kpiData.total_invoices !== undefined)
                ? kpiData.total_invoices
                : allCompanies.reduce(function(sum, c) { return sum + (c.invoices_count || c.inv_count || 0); }, 0);

            var avgTicket = (kpiData && kpiData.avg_ticket !== undefined)
                ? kpiData.avg_ticket
                : (totalInvoices > 0 ? totalRevenue / totalInvoices : 0);

            var totalC2 = (kpiData && kpiData.total_c2 !== undefined) ? kpiData.total_c2 : allCompanies.length;
            var share = (kpiData && kpiData.share_of_total_base !== undefined) ? kpiData.share_of_total_base : 48.3;
            var pot = (kpiData && kpiData.growth_potential !== undefined) ? kpiData.growth_potential : 0;

            var elTot = document.getElementById('kpi-total-c2'); if (elTot) elTot.textContent = fmtN(totalC2);
            var elTitle = document.getElementById('title-count'); if (elTitle) elTitle.textContent = fmtN(totalC2);
            var elRev = document.getElementById('kpi-revenue'); if (elRev) elRev.textContent = fmtM(totalRevenue);
            var elInv = document.getElementById('kpi-invoices'); if (elInv) elInv.textContent = fmtN(totalInvoices) + ' накл.';
            var elAvg = document.getElementById('kpi-avg-check'); if (elAvg) elAvg.textContent = fmtM(avgTicket);
            var elShare = document.getElementById('kpi-share'); if (elShare) elShare.textContent = share + '%';
            var elPot = document.getElementById('kpi-potential'); if (elPot) elPot.textContent = fmtM(pot);
        }

        async function loadCompaniesFromDB() {
            var lblYear = document.getElementById('lbl-year');
            if (lblYear) lblYear.textContent = curYear;

            try {
                var url = '/api/analytics/c2-segmentation-companies?token=' + encodeURIComponent(TOKEN) + '&year=' + curYear + '&filter_mode=' + encodeURIComponent(curFilterMode);
                var resp = await fetch(url);
                if (!resp.ok) {
                    throw new Error('HTTP ' + resp.status + ' ' + resp.statusText);
                }
                var json = await resp.json();

                if (json.status === 'ok') {
                    allCompanies = json.data || [];
                    filteredCompanies = allCompanies.slice();
                    topProducts = json.top_products || [];

                    // Update badges
                    var bAll = document.getElementById('badge-all'); if (bAll) bAll.textContent = fmtN(allCompanies.length);
                    var bRev = document.getElementById('badge-rev'); if (bRev) bRev.textContent = fmtN(allCompanies.length);
                    var bTon = document.getElementById('badge-ton'); if (bTon) bTon.textContent = fmtN(allCompanies.length);

                    // Update KPIs
                    updateKPIs(json.kpi);

                    // Init Charts
                    initCharts(json);

                    // Render Table
                    applyFilters();
                } else {
                    document.getElementById('companiesTbody').innerHTML = '<tr><td colspan="11" style="text-align:center;padding:30px;color:#dc2626;">⚠️ Помилка завантаження даних</td></tr>';
                }
            } catch (e) {
                console.error('loadCompaniesFromDB error:', e);
                document.getElementById('companiesTbody').innerHTML = '<tr><td colspan="11" style="text-align:center;padding:30px;color:#dc2626;">⚠️ Помилка сервера: ' + e.message + '</td></tr>';
            }
        }

        function setFilterMode(mode, btnEl) {
            curFilterMode = mode;
            document.querySelectorAll('.cohort-btn').forEach(function(b) { b.classList.remove('active'); });
            if (btnEl) btnEl.classList.add('active');
            loadCompaniesFromDB();
        }

        function applyFilters() {
            var search = (document.getElementById('searchInput').value || '').toLowerCase().trim();
            var cohort = document.getElementById('filterCohort').value;
            var sortBy = document.getElementById('sortBy').value;

            filteredCompanies = allCompanies.filter(function(c) {
                if (cohort !== 'ALL' && c.cohort !== cohort) return false;
                if (search && !c.code.toLowerCase().includes(search) && !c.name.toLowerCase().includes(search)) return false;
                return true;
            });

            // Sorting
            filteredCompanies.sort(function(a, b) {
                var invA = a.invoices_count || a.inv_count || 0;
                var invB = b.invoices_count || b.inv_count || 0;
                if (sortBy === 'rev_desc') return b.goods_revenue - a.goods_revenue;
                if (sortBy === 'rev_asc') return a.goods_revenue - b.goods_revenue;
                if (sortBy === 'ton_desc') return b.total_tonnage - a.total_tonnage;
                if (sortBy === 'ton_asc') return a.total_tonnage - b.total_tonnage;
                if (sortBy === 'inv_desc') return invB - invA;
                if (sortBy === 'avg_desc') return b.avg_ticket - a.avg_ticket;
                if (sortBy === 'name_asc') return a.name.localeCompare(b.name, 'uk');
                return b.goods_revenue - a.goods_revenue;
            });

            renderTable();
        }

        function renderTable() {
            var tbody = document.getElementById('companiesTbody');
            var counter = document.getElementById('tableCounter');
            if (!tbody) return;

            var totalRevFiltered = filteredCompanies.reduce(function(sum, c) { return sum + (c.goods_revenue || 0); }, 0);
            if (counter) {
                counter.innerHTML = 'Показано <strong>' + fmtN(filteredCompanies.length) + '</strong> з ' + fmtN(allCompanies.length) + ' компаній (Виручка: <strong>' + fmtM(totalRevFiltered) + '</strong>)';
            }

            if (!filteredCompanies.length) {
                tbody.innerHTML = '<tr><td colspan="11" style="text-align:center;padding:30px;color:#94a3b8;">Не знайдено жодної компанії за обраними фільтрами</td></tr>';
                return;
            }

            var rowsHtml = filteredCompanies.map(function(c, idx) {
                var detailUrl = '/client-detail?token=' + encodeURIComponent(TOKEN) + '&code=' + encodeURIComponent(c.code);
                var invs = c.invoices_count || c.inv_count || 0;
                return '<tr>' +
                    '<td class="text-center" style="color:#94a3b8;font-weight:600;">' + (idx + 1) + '</td>' +
                    '<td><a href="' + detailUrl + '" class="client-code-badge">' + c.code + '</a></td>' +
                    '<td><a href="' + detailUrl + '" class="client-row-link">' + c.name + '</a></td>' +
                    '<td class="text-center"><span class="badge badge-cohort">' + (c.cohort || 'Разові (1)') + '</span></td>' +
                    '<td class="text-center" style="font-weight:700;">' + fmtN(invs) + '</td>' +
                    '<td class="text-right" style="font-weight:800;color:#0f172a;">' + fmtM(c.goods_revenue) + '</td>' +
                    '<td class="text-right" style="font-weight:700;color:#d97706;">' + Number(c.total_tonnage || 0).toFixed(3) + ' т</td>' +
                    '<td class="text-right" style="font-weight:600;color:#4f46e5;">' + fmtM(c.avg_ticket) + '</td>' +
                    '<td class="text-center"><span class="badge badge-c2">💡 Лайт</span></td>' +
                    '<td style="color:#64748b;font-size:12.5px;">' + (c.industry || 'Не вказано') + '</td>' +
                    '<td class="text-center">' +
                        '<button class="action-eye-btn" data-code="' + c.code + '" style="background:#fffbeb;border:1px solid #fde68a;color:#b45309;padding:4px 8px;border-radius:6px;cursor:pointer;font-size:12px;" title="Швидкий перегляд">' +
                            '<i class="fa-solid fa-eye"></i>' +
                        '</button>' +
                    '</td>' +
                '</tr>';
            }).join('');

            tbody.innerHTML = rowsHtml;
        }

        function initCharts(json) {
            var cc = json.cohort_counts || {};
            var prods = json.top_products || [];

            // Chart 1: Cohorts Distribution Bar
            var canvas1 = document.getElementById('chartC2Frequency');
            if (canvas1) {
                var ctx1 = canvas1.getContext('2d');
                if (chartC2FreqInstance) chartC2FreqInstance.destroy();
                var cohortLabels = ['Разові (1)', 'Повторні (2-3)', 'Квартальні (4-10)', 'Місячні (11-40)', 'Тижневі (41-170)', 'Щоденні (>170)'];
                var cohortVals = cohortLabels.map(function(k) { return cc[k] || 0; });

                chartC2FreqInstance = new Chart(ctx1, {
                    type: 'bar',
                    data: {
                        labels: cohortLabels,
                        datasets: [{
                            label: 'Кількість клієнтів Лайт',
                            data: cohortVals,
                            backgroundColor: 'rgba(217, 119, 6, 0.85)',
                            borderColor: '#d97706',
                            borderWidth: 1,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(c) { return ' ' + c.raw + ' компаній'; }
                                }
                            }
                        },
                        scales: {
                            x: { grid: { display: false }, ticks: { font: { family: 'Inter', size: 10.5, weight: '600' } } },
                            y: {
                                grid: { color: 'rgba(226, 232, 240, 0.6)' },
                                ticks: { font: { family: 'Inter', size: 10 } }
                            }
                        }
                    }
                });
            }

            // Chart 2: TOP-10 Products Horizontal Bar
            var canvas2 = document.getElementById('chartC2TopProducts');
            if (canvas2) {
                var ctx2 = canvas2.getContext('2d');
                if (chartC2TopProdInstance) chartC2TopProdInstance.destroy();

                var prodLabels = prods.map(function(p) {
                    var n = p.name || p.code;
                    return n.length > 28 ? n.substring(0, 26) + '...' : n;
                });
                var prodRevs = prods.map(function(p) { return p.total_amount / 1000.0; });

                chartC2TopProdInstance = new Chart(ctx2, {
                    type: 'bar',
                    data: {
                        labels: prodLabels,
                        datasets: [{
                            axis: 'y',
                            label: 'Виручка (тис. ₴)',
                            data: prodRevs,
                            backgroundColor: 'rgba(37, 99, 235, 0.85)',
                            borderColor: '#2563eb',
                            borderWidth: 1,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(c) { return ' Виручка: ' + c.raw.toFixed(1) + ' тис. ₴'; }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { color: 'rgba(226, 232, 240, 0.6)' },
                                ticks: { callback: function(v) { return v + 'K ₴'; }, font: { family: 'Inter', size: 10 } }
                            },
                            y: {
                                grid: { display: false },
                                ticks: { font: { family: 'Inter', size: 10, weight: '500' } }
                            }
                        }
                    }
                });
            }
        }

        function openCompanyModalByCode(code) {
            var c = allCompanies.find(function(item) { return String(item.code) === String(code); });
            if (!c) return;

            document.getElementById('modalCompName').textContent = c.name;
            document.getElementById('modalCompCode').textContent = c.code;
            document.getElementById('modalRevenue').textContent = fmtM(c.goods_revenue);
            document.getElementById('modalTonnage').textContent = Number(c.total_tonnage || 0).toFixed(3) + ' т';
            document.getElementById('modalCohort').textContent = c.cohort || 'Разові (1)';
            document.getElementById('modalInvoices').textContent = fmtN(c.invoices_count || c.inv_count || 0);
            document.getElementById('modalAvgTicket').textContent = fmtM(c.avg_ticket);
            document.getElementById('modalIndustry').textContent = c.industry || 'Не вказано';
            document.getElementById('modalStatus').textContent = c.status_name || 'Активний';
            document.getElementById('modalCardLink').href = '/client-detail?token=' + encodeURIComponent(TOKEN) + '&code=' + encodeURIComponent(c.code);

            document.getElementById('companyModal').classList.add('active');
        }

        function closeCompanyModal(e) {
            document.getElementById('companyModal').classList.remove('active');
        }

        function exportToCSV() {
            if (!filteredCompanies.length) {
                alert('Немає даних для експорту');
                return;
            }

            var headers = ['Код 1С', 'Назва компанії', 'Когорта', 'Накладних', 'Товарна виручка (грн)', 'Послуги (грн)', 'Тоннаж (т)', 'Середній чек (грн)', 'ABC', 'Галузь'];
            var csvRows = [headers.join(';')];

            filteredCompanies.forEach(function(c) {
                var invs = c.invoices_count || c.inv_count || 0;
                var row = [
                    '"' + (c.code || '').replace(/"/g, '""') + '"',
                    '"' + (c.name || '').replace(/"/g, '""') + '"',
                    '"' + (c.cohort || '') + '"',
                    invs,
                    c.goods_revenue,
                    c.services_revenue,
                    c.total_tonnage,
                    c.avg_ticket,
                    '"C2"',
                    '"' + (c.industry || '').replace(/"/g, '""') + '"'
                ];
                csvRows.push(row.join(';'));
            });

            var csvString = '\uFEFF' + csvRows.join('\r\n');
            var blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = 'c2_segmentation_' + curYear + '.csv';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeCompanyModal();
        });

        document.addEventListener('DOMContentLoaded', function() {
            var tbody = document.getElementById('companiesTbody');
            if (tbody) {
                tbody.addEventListener('click', function(e) {
                    var btn = e.target.closest('.action-eye-btn');
                    if (btn) {
                        var code = btn.getAttribute('data-code');
                        if (code) openCompanyModalByCode(code);
                    }
                });
            }
            loadCompaniesFromDB();
        });
    </script>
</body>
</html>
