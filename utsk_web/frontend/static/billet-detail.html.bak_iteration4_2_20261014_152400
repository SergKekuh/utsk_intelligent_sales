        // ─── Dynamic Section & Lightbox (Prompt 65 / Ітерація 4.1) ───
        /**
         * Визначає форму перерізу для SVG-схем.
         * @param {Object} data — відповідь API /api/analytics/billet-detail
         * @returns {Object} { shape, a, b, s } — shape: 'round' | 'square' | 'rect'
         */
        function detectSectionShape(data) {
            if (!data) return { shape: 'square', a: 40, b: 40, s: 4 };
            
            const category = data.product_category;
            const wall = parseFloat(data.wall) || 4;
            
            // Кругла заготовка → показуємо коло
            if (category === 'round') {
                return {
                    shape: 'round',
                    a: parseFloat(data.diameter) || 50,
                    b: parseFloat(data.diameter) || 50,
                    s: wall,
                };
            }
            
            // Профільна → беремо target_profile з calculation
            const calc = data.calculation;
            if (calc && calc.supported) {
                const a = parseFloat(calc.target_a) || 40;
                const b = parseFloat(calc.target_b) || 40;
                return {
                    shape: (Math.abs(a - b) < 0.5) ? 'square' : 'rect',
                    a, b, s: wall,
                };
            }
            
            // Fallback: беремо з prof_w / prof_h
            const profW = parseFloat(data.prof_w) || 40;
            const profH = parseFloat(data.prof_h) || 40;
            return {
                shape: (Math.abs(profW - profH) < 0.5) ? 'square' : 'rect',
                a: profW, b: profH, s: wall,
            };
        }

        /**
         * Генерує SVG контуру перерізу.
         * @param {Object} sec — { shape, a, b, s }
         * @returns {String} SVG-розмітка
         */
        function renderProfileSection(sec) {
            const { shape, a, b, s } = sec;
            
            const maxDim = Math.max(a, b);
            const scale = 140 / maxDim;
            const w = a * scale;
            const h = b * scale;
            const t = Math.max(6, s * scale); // видима товщина стінки
            
            const cx = 130, cy = 95; // центр контуру у viewBox 300×220
            const x0 = cx - w / 2;
            const y0 = cy - h / 2;
            
            if (shape === 'round') {
                const r = Math.min(w, h) / 2;
                return `
                    <circle class="metal-fill" cx="${cx}" cy="${cy}" r="${r}"/>
                    <circle class="metal" cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke-width="2"/>
                    <circle class="metal" cx="${cx}" cy="${cy}" r="${Math.max(2, r - t)}" fill="none" stroke-width="1.5" stroke-dasharray="4 2"/>
                `;
            }
            
            // Квадрат / прямокутник з подвійним радіусом (r₀ і rᵢ = r₀ - t)
            const r0 = Math.min(20, Math.min(w, h) / 6); // зовнішній радіус
            const ri = Math.max(2, r0 - t);              // внутрішній радіус
            
            // Зовнішній контур (r₀)
            const outer = `
                M ${x0 + r0} ${y0}
                H ${x0 + w - r0}
                A ${r0} ${r0} 0 0 1 ${x0 + w} ${y0 + r0}
                V ${y0 + h - r0}
                A ${r0} ${r0} 0 0 1 ${x0 + w - r0} ${y0 + h}
                H ${x0 + r0}
                A ${r0} ${r0} 0 0 1 ${x0} ${y0 + h - r0}
                V ${y0 + r0}
                A ${r0} ${r0} 0 0 1 ${x0 + r0} ${y0}
                Z
            `;
            
            // Внутрішній контур (rᵢ = r₀ − t)
            const xi = x0 + t, yi = y0 + t;
            const wi = Math.max(4, w - 2 * t), hi = Math.max(4, h - 2 * t);
            const inner = `
                M ${xi + ri} ${yi}
                H ${xi + wi - ri}
                A ${ri} ${ri} 0 0 1 ${xi + wi} ${yi + ri}
                V ${yi + hi - ri}
                A ${ri} ${ri} 0 0 1 ${xi + wi - ri} ${yi + hi}
                H ${xi + ri}
                A ${ri} ${ri} 0 0 1 ${xi} ${yi + hi - ri}
                V ${yi + ri}
                A ${ri} ${ri} 0 0 1 ${xi + ri} ${yi}
                Z
            `;
            
            return `
                <path class="metal-fill" d="${outer}"/>
                <path class="metal" d="${outer}" fill="none" stroke-width="2"/>
                <path class="metal" d="${inner}" fill="none" stroke-width="1.5" stroke-dasharray="4 2"/>
            `;
        }

        /**
         * Оновлює Схему 1 (Вимірювань) динамічним контуром та розмірними лініями
         */
        function updateScheme1(sec) {
            const svgEl = document.getElementById('schema1Svg');
            if (!svgEl) return;
            
            const contour = renderProfileSection(sec);
            let dims = '';
            
            if (sec.shape === 'round') {
                const cx = 130, cy = 95;
                const r = 70;
                dims = `
                    <!-- Діаметр D -->
                    <line class="dim" x1="${cx - r}" y1="${cy}" x2="${cx + r}" y2="${cy}"/>
                    <polygon class="arrow" points="${cx - r},${cy} ${cx - r + 8},${cy - 4} ${cx - r + 8},${cy + 4}"/>
                    <polygon class="arrow" points="${cx + r},${cy} ${cx + r - 8},${cy - 4} ${cx + r - 8},${cy + 4}"/>
                    <text class="label-mono" x="${cx - 15}" y="${cy - 6}">Ø ${sec.a}</text>
                    
                    <!-- Товщина стінки t -->
                    <line class="dim-dashed" x1="220" y1="95" x2="250" y2="95"/>
                    <text class="label-mono" x="228" y="90">S=${sec.s}</text>
                    
                    <!-- База заміру >= 100 мм від торця -->
                    <line class="tolerance-dashed" x1="60" y1="195" x2="200" y2="195"/>
                    <line class="dim" x1="60" y1="190" x2="60" y2="200"/>
                    <line class="dim" x1="200" y1="190" x2="200" y2="200"/>
                    <text class="label-small" x="78" y="210">≥ 100 мм від торця (п. 5.2.3)</text>
                `;
            } else {
                const maxDim = Math.max(sec.a, sec.b);
                const scale = 140 / maxDim;
                const w = sec.a * scale;
                const h = sec.b * scale;
                const cx = 130, cy = 95;
                const x0 = cx - w / 2;
                const y0 = cy - h / 2;
                const x1 = cx + w / 2;
                const y1 = cy + h / 2;
                
                dims = `
                    <!-- Висота H -->
                    <line class="dim" x1="${x1 + 18}" y1="${y0}" x2="${x1 + 18}" y2="${y1}"/>
                    <polygon class="arrow" points="${x1 + 18},${y0} ${x1 + 14},${y0 + 8} ${x1 + 22},${y0 + 8}"/>
                    <polygon class="arrow" points="${x1 + 18},${y1} ${x1 + 14},${y1 - 8} ${x1 + 22},${y1 - 8}"/>
                    <line class="dim" x1="${x1}" y1="${y0}" x2="${x1 + 22}" y2="${y0}"/>
                    <line class="dim" x1="${x1}" y1="${y1}" x2="${x1 + 22}" y2="${y1}"/>
                    <text class="label-mono" x="${x1 + 24}" y="${cy + 4}">H</text>
                    
                    <!-- Ширина B -->
                    <line class="dim" x1="${x0}" y1="${y1 + 15}" x2="${x1}" y2="${y1 + 15}"/>
                    <polygon class="arrow" points="${x0},${y1 + 15} ${x0 + 8},${y1 + 11} ${x0 + 8},${y1 + 19}"/>
                    <polygon class="arrow" points="${x1},${y1 + 15} ${x1 - 8},${y1 + 11} ${x1 - 8},${y1 + 19}"/>
                    <line class="dim" x1="${x0}" y1="${y1}" x2="${x0}" y2="${y1 + 18}"/>
                    <line class="dim" x1="${x1}" y1="${y1}" x2="${x1}" y2="${y1 + 18}"/>
                    <text class="label-mono" x="${cx - 4}" y="${y1 + 27}">B</text>
                    
                    <!-- Стінка t -->
                    <line class="dim-dashed" x1="${x0}" y1="${cy - 20}" x2="${x0 + 12}" y2="${cy - 20}"/>
                    <text class="label-mono" x="${x0 + 16}" y="${cy - 16}">t</text>
                    
                    <!-- База заміру >= 100 мм від торця -->
                    <line class="tolerance-dashed" x1="60" y1="195" x2="200" y2="195"/>
                    <line class="dim" x1="60" y1="190" x2="60" y2="200"/>
                    <line class="dim" x1="200" y1="190" x2="200" y2="200"/>
                    <text class="label-small" x="78" y="210">≥ 100 мм від торця (п. 5.2.3)</text>
                `;
            }
            
            svgEl.innerHTML = contour + dims;
        }

        /**
         * Ініціалізація Lightbox для SVG-схем.
         */
        function initSvgLightbox() {
            const lightbox = document.getElementById('svgLightbox');
            if (!lightbox) return;
            const titleEl = lightbox.querySelector('.lightbox__title');
            const svgEl = lightbox.querySelector('.lightbox__svg');
            const refEl = lightbox.querySelector('.lightbox__ref');
            const closeBtn = lightbox.querySelector('.lightbox__close');
            
            function open(card) {
                const title = card.querySelector('.tolerance-card__title')?.textContent || 'Схема';
                const svg = card.querySelector('svg');
                const desc = card.querySelector('.tolerance-card__desc')?.innerHTML || '';
                const badge = card.querySelector('.tolerance-card__badge')?.textContent || '';
                
                if (titleEl) titleEl.textContent = title;
                if (svgEl) svgEl.innerHTML = svg ? svg.outerHTML : '';
                if (refEl) refEl.innerHTML = `${badge ? '<strong>' + badge + '</strong><br>' : ''}${desc}`;
                lightbox.style.display = 'flex';
                document.body.style.overflow = 'hidden';
            }
            
            function close() {
                lightbox.style.display = 'none';
                document.body.style.overflow = '';
            }
            
            // Клік на карточку — відкрити
            document.querySelectorAll('.tolerance-card').forEach(card => {
                card.style.cursor = 'pointer';
                
                // Додати іконку лупи якщо її ще немає
                if (!card.querySelector('.tolerance-card__zoom-icon')) {
                    const icon = document.createElement('div');
                    icon.className = 'tolerance-card__zoom-icon';
                    icon.innerHTML = '<i class="fa-solid fa-maximize"></i>';
                    card.appendChild(icon);
                }
                
                card.addEventListener('click', (e) => {
                    if (e.target.closest('a')) return;
                    open(card);
                });
            });
            
            // Закриття
            if (closeBtn) closeBtn.addEventListener('click', close);
            lightbox.addEventListener('click', (e) => {
                if (e.target === lightbox) close();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && lightbox.style.display === 'flex') close();
            });
        }

        // ─── Update Block 4 Dynamic Badges (Prompt 64) ───
        function updateToleranceBadges(s) {
            if (!s || isNaN(s)) return;
            const r0Badge = document.getElementById('badgeTolR0');
            if (r0Badge) {
                let range;
                if (s <= 6) {
                    range = `1.6t … 2.4t (${(1.6 * s).toFixed(1)} … ${(2.4 * s).toFixed(1)} мм)`;
                } else if (s <= 10) {
                    range = `2.0t … 3.0t (${(2.0 * s).toFixed(1)} … ${(3.0 * s).toFixed(1)} мм)`;
                } else {
                    range = `2.4t … 3.6t (${(2.4 * s).toFixed(1)} … ${(3.6 * s).toFixed(1)} мм)`;
                }
                r0Badge.textContent = range;
            }
            const weldBadge = document.getElementById('badgeTolWeld');
            if (weldBadge) {
                const gratLimit = s <= 4 ? 0.5 : 1.0;
                const xMin = (4 * s).toFixed(s % 1 === 0 ? 0 : 1);
                weldBadge.textContent = `X ≥ 4t (${xMin} мм) / грат ≤ ${gratLimit} мм`;
            }
        }

        // ─── Main Controller Execution ───
        document.addEventListener('DOMContentLoaded', async () => {
            initPageMeta();
            initSvgLightbox();

            try {
                // 1. Initial request for billet summary and profiling
                const billetUrl = `/api/analytics/billet-detail?token=${TOKEN}&code=${CLIENT_CODE}&size_key=${SIZE_KEY}&year=${YEAR}`;
                const resBillet = await fetch(billetUrl);
                if (!resBillet.ok) throw new Error(`HTTP ${resBillet.status} при завантаженні заготовки`);
                const billetJson = await resBillet.json();

                billetData = billetJson.data;
                renderBlock1(billetData);
                if (billetData.wall) {
                    updateToleranceBadges(billetData.wall);
                }

                // Ініціалізація динамічного перерізу та Lightbox (Ітерація 4.1)
                const section = detectSectionShape(billetData);
                updateScheme1(section);
                initSvgLightbox();

                const calc = billetData.calculation || {};
                const isSupported = calc.supported !== false;
                renderBlock2(calc, isSupported);

                // 2. If supported, load square and rectangular candidates via enumerate
                if (isSupported && billetData.diameter && billetData.wall) {
                    const d = billetData.diameter;
                    const s = billetData.wall;

                    const [sqResp, rcResp] = await Promise.all([
                        fetch(`/api/analytics/vniti/enumerate?token=${TOKEN}&diameter=${d}&wall=${s}&shape=square&step_mm=1.0`).then(r => r.json()),
                        fetch(`/api/analytics/vniti/enumerate?token=${TOKEN}&diameter=${d}&wall=${s}&shape=rect&step_mm=5.0`).then(r => r.json())
                    ]);

                    renderBlock3(sqResp.data || [], rcResp.data || [], s);
                } else {
                    renderBlock3([], [], billetData.wall || 0);
                }

            } catch (err) {
                console.error('Помилка завантаження сторінки /billet-detail:', err);
                const block1 = document.getElementById('block1Container');
                if (block1) {
                    block1.innerHTML = `
                        <div class="state-container" style="color:var(--danger);">
                            <i class="fa-solid fa-circle-exclamation" style="font-size:24px; margin-bottom:8px;"></i>
                            <div>Не вдалося завантажити дані для заготовки: ${err.message}</div>
                        </div>
                    `;
                }
            }
        });
    </script>
</body>
