<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>👥 UTSK — Аналитика клиентов по отраслям</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        :root {
            --bg-main: #f8fafc;
            --bg-card: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --border-light: #f1f5f9;
            --brand: #0284c7;
            --brand-light: #e0f2fe;
            --accent: #8b5cf6;
            --good: #10b981;
            --warn: #f59e0b;
            --danger: #ef4444;
            --radius-lg: 16px;
            --radius-md: 12px;
            --radius-sm: 8px;
            --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.05);
            --shadow-md: 0 4px 12px rgba(15, 23, 42, 0.08);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-main);
            color: var(--text-main);
            min-height: 100vh;
            padding: 24px;
            line-height: 1.5;
        }

        .container { max-width: 1600px; margin: 0 auto; }

        .page-header {
            background: var(--bg-card);
            padding: 20px 24px;
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .header-title-area { display: flex; align-items: center; gap: 14px; }
        .header-icon {
            width: 48px; height: 48px; border-radius: 12px;
            background: #f5f3ff; color: var(--accent);
            display: flex; align-items: center; justify-content: center;
            font-size: 24px;
        }
        .header-title h1 { font-size: 22px; font-weight: 800; color: var(--text-main); }
        .header-title p { font-size: 13px; color: var(--text-muted); margin-top: 2px; }

        .header-controls { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
        .select-year {
            padding: 9px 16px; border: 1px solid var(--border);
            border-radius: var(--radius-md); background: var(--bg-card);
            font-weight: 600; font-size: 14px; cursor: pointer; color: var(--text-main);
        }
        .btn-nav {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 9px 16px; border-radius: var(--radius-md);
            font-size: 13px; font-weight: 600; text-decoration: none;
            background: #f1f5f9; color: var(--text-main); border: 1px solid var(--border);
            transition: all 0.15s;
        }
        .btn-nav:hover { background: var(--brand-light); color: var(--brand); border-color: #bae6fd; }
        .btn-nav.primary { background: var(--accent); color: white; border-color: var(--accent); }
        .btn-nav.primary:hover { background: #7c3aed; }

        /* KPI Grid */
        .kpi-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px; margin-bottom: 24px;
        }
        .kpi-card {
            background: var(--bg-card); border-radius: var(--radius-lg);
            padding: 20px; border: 1px solid var(--border);
            box-shadow: var(--shadow-sm); position: relative; overflow: hidden;
        }
        .kpi-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
            background: var(--accent);
        }
        .kpi-card.purple::before { background: var(--accent); }
        .kpi-card.blue::before { background: var(--brand); }
        .kpi-card.green::before { background: var(--good); }
        .kpi-card.amber::before { background: var(--warn); }
        .kpi-card.indigo::before { background: #6366f1; }

        .kpi-label {
            font-size: 12px; font-weight: 700; color: var(--text-muted);
            text-transform: uppercase; letter-spacing: 0.5px;
            margin-bottom: 8px; display: flex; align-items: center; gap: 8px;
        }
        .kpi-value {
            font-family: 'JetBrains Mono', monospace; font-size: 26px; font-weight: 800;
            color: var(--text-main); line-height: 1.2;
        }
        .kpi-sub { font-size: 12px; color: var(--text-muted); margin-top: 6px; }

        /* Charts Row */
        .grid-2 {
            display: grid; grid-template-columns: 1.3fr 1fr; gap: 20px; margin-bottom: 24px;
        }
        @media (max-width: 1024px) { .grid-2 { grid-template-columns: 1fr; } }

        .card {
            background: var(--bg-card); border-radius: var(--radius-lg);
            border: 1px solid var(--border); padding: 22px;
            box-shadow: var(--shadow-sm);
        }
        .card-header {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 16px;
        }
        .card-title {
            font-size: 16px; font-weight: 700; display: flex; align-items: center; gap: 10px;
        }
        .chart-box { position: relative; height: 350px; }

        /* Tables */
        .table-responsive { overflow-x: auto; margin-top: 8px; }
        .data-table {
            width: 100%; border-collapse: collapse; font-size: 13.5px;
        }
        .data-table th {
            text-align: left; padding: 12px 14px;
            background: #f8fafc; color: var(--text-muted);
            font-weight: 700; font-size: 11.5px; text-transform: uppercase;
            letter-spacing: 0.5px; border-bottom: 2px solid var(--border);
            white-space: nowrap;
        }
        .data-table td {
            padding: 12px 14px; border-bottom: 1px solid var(--border-light);
            vertical-align: middle;
        }
        .data-table tr:hover td { background: #f8fafc; }
        .num { font-family: 'JetBrains Mono', monospace; text-align: right; }
        .progress-bar-bg {
            background: #e2e8f0; height: 6px; border-radius: 3px; overflow: hidden; margin-top: 4px;
        }
        .progress-bar-fill {
            height: 100%; background: var(--accent); border-radius: 3px;
        }
        .status-pill {
            display: inline-block; padding: 3px 8px; border-radius: 6px;
            font-size: 11.5px; font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <header class="page-header">
            <div class="header-title-area">
                <div class="header-icon">👥</div>
                <div class="header-title">
                    <h1>Аналитика клиентской базы по отраслям</h1>
                    <p>Структура активных контрагентов, статусное распределение и наполненность ЄДРПОУ</p>
                </div>
            </div>
            <div class="header-controls">
                <select id="yearSelect" class="select-year" onchange="onYearChange()">
                    <option value="2026">2026 год</option>
                    <option value="2025">2025 год</option>
                    <option value="2024">2024 год</option>
                </select>
                <a href="#" id="backToDirectionsBtn" class="btn-nav primary">← К направлениям</a>
                <a href="/?token=utsk2026" class="btn-nav">🏠 Дашборд</a>
            </div>
        </header>

        <!-- KPI Cards -->
        <section class="kpi-grid">
            <div class="kpi-card purple">
                <div class="kpi-label"><i class="fa-solid fa-users"></i> Активных клиентов</div>
                <div class="kpi-value" id="kpi-active-clients">—</div>
                <div class="kpi-sub" id="kpi-active-clients-sub">Покупали в выбранном году</div>
            </div>
            <div class="kpi-card blue">
                <div class="kpi-label"><i class="fa-solid fa-address-book"></i> Всего в базе</div>
                <div class="kpi-value" id="kpi-total-base">—</div>
                <div class="kpi-sub">Историческая база клиентов</div>
            </div>
            <div class="kpi-card green">
                <div class="kpi-label"><i class="fa-solid fa-id-card"></i> С кодом ЄДРПОУ</div>
                <div class="kpi-value" id="kpi-with-edrpou">—</div>
                <div class="kpi-sub" id="kpi-with-edrpou-sub">Верифицированные юрлица</div>
            </div>
            <div class="kpi-card amber">
                <div class="kpi-label"><i class="fa-solid fa-user-plus"></i> Новых клиентов</div>
                <div class="kpi-value" id="kpi-new-clients">—</div>
                <div class="kpi-sub" id="kpi-new-clients-sub">Первые сделки в году</div>
            </div>
            <div class="kpi-card indigo">
                <div class="kpi-label"><i class="fa-solid fa-coins"></i> Выручка на клиента</div>
                <div class="kpi-value" id="kpi-rev-per-client">—</div>
                <div class="kpi-sub">Средний доход на контрагента</div>
            </div>
        </section>

        <!-- Charts Row -->
        <section class="grid-2">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title"><i class="fa-solid fa-chart-bar" style="color:var(--accent)"></i> Клиенты по отраслям</h3>
                    <span id="chartClientsTag" style="font-size:12px;color:var(--text-muted);">Активные в 2026</span>
                </div>
                <div class="chart-box">
                    <canvas id="chartClientsBar"></canvas>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h3 class="card-title"><i class="fa-solid fa-pie-chart" style="color:var(--brand)"></i> Распределение по статусам</h3>
                    <span style="font-size:12px;color:var(--text-muted);">Все покупатели года</span>
                </div>
                <div class="chart-box">
                    <canvas id="chartStatusesPie"></canvas>
                </div>
            </div>
        </section>

        <!-- Table 1: Direction Clients Breakdown -->
        <section class="card" style="margin-bottom: 24px;">
            <div class="card-header">
                <h3 class="card-title"><i class="fa-solid fa-table" style="color:var(--good)"></i> Клиентская структура по отраслям</h3>
                <span id="tableDirsSub" style="font-size:13px;color:var(--text-muted);">14 отраслей</span>
            </div>
            <div class="table-responsive">
                <table class="data-table" id="tableClients">
                    <thead>
                        <tr>
                            <th style="width: 40px;">#</th>
                            <th>Отрасль</th>
                            <th class="num">Клиентов</th>
                            <th style="width: 140px;">Доля клиентов</th>
                            <th class="num">С ЄДРПОУ</th>
                            <th class="num">Новых</th>
                            <th class="num">Повторных</th>
                            <th class="num">Регулярных</th>
                            <th class="num">Выручка</th>
                            <th class="num">Ср. выручка / кл.</th>
                        </tr>
                    </thead>
                    <tbody id="clientsTbody">
                        <tr><td colspan="10" style="text-align:center;padding:24px;color:var(--text-muted);">Загрузка аналитики...</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Table 2: Top Overall Clients -->
        <section class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fa-solid fa-award" style="color:var(--warn)"></i> ТОП-10 ключевых клиентов по объёму покупок</h3>
                <span style="font-size:13px;color:var(--text-muted);">Лидеры портфеля UTSK</span>
            </div>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width: 40px;">#</th>
                            <th>Код</th>
                            <th>Наименование клиента</th>
                            <th>ЄДРПОУ</th>
                            <th>Отрасль</th>
                            <th>Статус CRM</th>
                            <th class="num">Выручка от товаров</th>
                            <th class="num">Накладных</th>
                        </tr>
                    </thead>
                    <tbody id="topClientsTbody">
                        <tr><td colspan="8" style="text-align:center;padding:20px;color:var(--text-muted);">Загрузка...</td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const TOKEN = urlParams.get('token') || 'utsk2026';
        let currentYear = parseInt(urlParams.get('year')) || 2026;

        let clientsBarChart = null;
        let statusesPieChart = null;

        function fmtM(val) {
            if (!val || isNaN(val)) return '0 ₴';
            const v = parseFloat(val);
            if (Math.abs(v) >= 1000000) {
                return (v / 1000000).toLocaleString('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' млн ₴';
            }
            return Math.round(v).toLocaleString('ru-RU') + ' ₴';
        }

        function fmtNum(val) {
            if (!val || isNaN(val)) return '0';
            return parseInt(val).toLocaleString('ru-RU');
        }

        function fmtPct(val) {
            if (!val || isNaN(val)) return '0.0%';
            return parseFloat(val).toFixed(1) + '%';
        }

        function onYearChange() {
            currentYear = parseInt(document.getElementById('yearSelect').value);
            window.location.href = `/directions-clients-analytics?token=${TOKEN}&year=${currentYear}`;
        }

        async function loadClientsAnalytics() {
            try {
                document.getElementById('backToDirectionsBtn').href = `/directions-analytics?token=${TOKEN}&year=${currentYear}`;
                document.getElementById('yearSelect').value = currentYear;
                document.getElementById('chartClientsTag').textContent = `Активные в ${currentYear}`;

                const res = await fetch(`/api/analytics/directions/clients-analytics?token=${TOKEN}&year=${currentYear}`);
                const json = await res.json();
                if (json.status !== 'ok' || !json.data) {
                    throw new Error('Не удалось загрузить данные');
                }
                renderDashboard(json.data);
            } catch (err) {
                console.error(err);
                document.getElementById('clientsTbody').innerHTML = `<tr><td colspan="10" style="text-align:center;color:var(--danger);padding:20px;">⚠️ Ошибка: ${err.message}</td></tr>`;
            }
        }

        function renderDashboard(data) {
            const dirs = data.directions || [];
            const totalClients = data.total_clients || 0;
            const totalInDb = data.total_in_db || 0;
            const totalEdrpou = data.total_with_edrpou || 0;
            const edrpouPct = totalClients > 0 ? (totalEdrpou / totalClients) * 100 : 0;

            let totalNew = 0;
            let totalRevenue = 0;
            const statusTotals = {};

            dirs.forEach(d => {
                totalNew += (d.new_clients || 0);
                totalRevenue += (d.revenue || 0);
                (d.statuses || []).forEach(s => {
                    statusTotals[s.status_name] = (statusTotals[s.status_name] || 0) + s.clients_count;
                });
            });

            const avgRevPerClient = totalClients > 0 ? totalRevenue / totalClients : 0;

            // KPI
            document.getElementById('kpi-active-clients').textContent = fmtNum(totalClients);
            document.getElementById('kpi-total-base').textContent = fmtNum(totalInDb);
            document.getElementById('kpi-with-edrpou').textContent = `${fmtNum(totalEdrpou)}`;
            document.getElementById('kpi-with-edrpou-sub').textContent = `${fmtPct(edrpouPct)} покрытия базы`;
            document.getElementById('kpi-new-clients').textContent = fmtNum(totalNew);
            document.getElementById('kpi-new-clients-sub').textContent = `${fmtPct(totalClients > 0 ? totalNew*100/totalClients : 0)} от активных`;
            document.getElementById('kpi-rev-per-client').textContent = fmtM(avgRevPerClient);
            document.getElementById('tableDirsSub').textContent = `${dirs.length} активных отраслей`;

            // Charts
            renderClientsBar(dirs);
            renderStatusesPie(statusTotals);

            // Tables
            renderClientsTable(dirs);
            renderTopClientsTable(data.top_overall_clients || []);
        }

        function renderClientsBar(dirs) {
            const ctx = document.getElementById('chartClientsBar').getContext('2d');
            if (clientsBarChart) clientsBarChart.destroy();

            const sorted = [...dirs].sort((a, b) => b.clients_count - a.clients_count).slice(0, 8);

            clientsBarChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: sorted.map(d => `${d.icon} ${d.direction_name}`),
                    datasets: [{
                        label: 'Количество клиентов',
                        data: sorted.map(d => d.clients_count),
                        backgroundColor: sorted.map(d => d.color),
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: ctx => ` Клиентов: ${ctx.raw} (${fmtPct(dirs[ctx.dataIndex] ? dirs[ctx.dataIndex].share_pct : 0)})`
                            }
                        }
                    },
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        function renderStatusesPie(statusTotals) {
            const ctx = document.getElementById('chartStatusesPie').getContext('2d');
            if (statusesPieChart) statusesPieChart.destroy();

            const labels = Object.keys(statusTotals);
            const values = Object.values(statusTotals);
            const statusColors = ['#0ea5e9', '#3b82f6', '#8b5cf6', '#10b981', '#f59e0b', '#ec4899', '#6366f1', '#14b8a6', '#64748b'];

            statusesPieChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: values,
                        backgroundColor: statusColors.slice(0, labels.length),
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right', labels: { boxWidth: 12, padding: 8, font: { size: 11 } } },
                        tooltip: {
                            callbacks: {
                                label: function(ctx) {
                                    const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                                    const pct = total > 0 ? ((ctx.raw / total) * 100).toFixed(1) : 0;
                                    return ` ${ctx.label}: ${ctx.raw} кл. (${pct}%)`;
                                }
                            }
                        }
                    },
                    cutout: '60%'
                }
            });
        }

        function renderClientsTable(dirs) {
            const tbody = document.getElementById('clientsTbody');
            if (!dirs || dirs.length === 0) {
                tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;padding:24px;">Нет данных</td></tr>';
                return;
            }

            tbody.innerHTML = dirs.map((d, idx) => `
                <tr>
                    <td style="color:var(--text-muted);font-weight:600;">${idx + 1}</td>
                    <td>
                        <div style="display:flex;align-items:center;gap:10px;">
                            <span style="font-size:18px;">${d.icon}</span>
                            <strong>${d.direction_name}</strong>
                        </div>
                    </td>
                    <td class="num" style="font-weight:800;color:var(--accent);">${fmtNum(d.clients_count)}</td>
                    <td>
                        <div style="display:flex;align-items:center;gap:8px;">
                            <span style="font-size:12px;font-weight:600;min-width:38px;">${fmtPct(d.share_pct)}</span>
                            <div class="progress-bar-bg" style="flex:1;">
                                <div class="progress-bar-fill" style="width:${Math.min(100, d.share_pct)}%;background:${d.color};"></div>
                            </div>
                        </div>
                    </td>
                    <td class="num" style="color:var(--good);font-weight:600;">${fmtNum(d.with_edrpou)}</td>
                    <td class="num">${fmtNum(d.new_clients)}</td>
                    <td class="num">${fmtNum(d.repeat_clients)}</td>
                    <td class="num">${fmtNum(d.regular_clients)}</td>
                    <td class="num" style="font-weight:700;">${fmtM(d.revenue)}</td>
                    <td class="num" style="font-weight:600;color:var(--brand);">${fmtM(d.avg_revenue_per_client)}</td>
                </tr>
            `).join('');
        }

        function renderTopClientsTable(clients) {
            const tbody = document.getElementById('topClientsTbody');
            if (!clients || clients.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:20px;">Нет клиентов</td></tr>';
                return;
            }

            tbody.innerHTML = clients.map((c, idx) => `
                <tr>
                    <td style="color:var(--text-muted);font-weight:600;">${idx + 1}</td>
                    <td style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--brand);font-weight:600;">
                        <a href="/client-detail?token=${TOKEN}&code=${c.code}" style="color:inherit;text-decoration:none;">${c.code}</a>
                    </td>
                    <td style="font-weight:700;">
                        <a href="/client-detail?token=${TOKEN}&code=${c.code}" style="color:inherit;text-decoration:none;">${c.name}</a>
                    </td>
                    <td style="font-family:'JetBrains Mono',monospace;font-size:12px;">${c.edrpou}</td>
                    <td><span class="status-pill" style="background:#f1f5f9;">${c.direction_name || '—'}</span></td>
                    <td><span class="status-pill" style="background:#ede9fe;color:#6d28d9;">${c.status_name}</span></td>
                    <td class="num" style="font-weight:700;color:var(--good);">${fmtM(c.revenue)}</td>
                    <td class="num">${fmtNum(c.invoices_count)}</td>
                </tr>
            `).join('');
        }

        window.addEventListener('DOMContentLoaded', loadClientsAnalytics);
    </script>
</body>
</html>
